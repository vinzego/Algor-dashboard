    // Active platform filter state
    let activePlatformFilter = 'all';
    let pickerInstance = null;

    // Initialize Modern Flatpickr Date Picker (Default: Current Month)
    function initDateFilter() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const firstDay = `${year}-${month}-01`;
      const lastDayNum = new Date(year, now.getMonth() + 1, 0).getDate();
      const lastDay = `${year}-${month}-${String(lastDayNum).padStart(2, '0')}`;

      pickerInstance = flatpickr("#date-range-picker", {
        mode: "range",
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d.m.Y.",
        defaultDate: [firstDay, lastDay],
        locale: flatpickr.l10ns.hr || "hr",
        onChange: function(selectedDates, dateStr, instance) {
          applyFilters();
        }
      });

      applyFilters();
    }

    // Set Date Range Presets
    function setDatePreset(preset) {
      if (!pickerInstance) return;

      if (preset === 'month') {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const firstDay = `${year}-${month}-01`;
        const lastDayNum = new Date(year, now.getMonth() + 1, 0).getDate();
        const lastDay = `${year}-${month}-${String(lastDayNum).padStart(2, '0')}`;
        pickerInstance.setDate([firstDay, lastDay]);
      } else if (preset === '7days') {
        const today = new Date();
        const sevenDaysAgo = new Date();
        sevenDaysAgo.setDate(today.getDate() - 7);
        pickerInstance.setDate([sevenDaysAgo, today]);
      } else if (preset === 'all') {
        pickerInstance.clear();
      }
      applyFilters();
    }

    // Filter Posts by Platform
    function setPlatformFilter(platform) {
      activePlatformFilter = platform;
      const filterBtns = ['all', 'instagram', 'facebook', 'tiktok'];
      filterBtns.forEach(p => {
        const btn = document.getElementById(`post-filter-${p}`);
        if (btn) {
          if (p === platform) {
            btn.className = 'px-4 py-2 rounded-full bg-[#111113] text-white shadow-xs font-black transition-all';
          } else {
            btn.className = 'px-4 py-2 rounded-full text-gray-700 hover:text-[#111113] transition-all font-black flex items-center gap-1.5';
          }
        }
      });
      applyFilters();
    }

    // Apply combined Platform & Date filters to Table and Gallery
    function applyFilters() {
      let startDateVal = '';
      let endDateVal = '';

      if (pickerInstance && pickerInstance.selectedDates.length > 0) {
        const d1 = pickerInstance.selectedDates[0];
        startDateVal = d1.toISOString().split('T')[0];
        if (pickerInstance.selectedDates.length > 1) {
          const d2 = pickerInstance.selectedDates[1];
          endDateVal = d2.toISOString().split('T')[0];
        } else {
          endDateVal = startDateVal; // single date selected
        }
      }

      // Filter Table Rows
      const tableRows = document.querySelectorAll('.post-row-item');
      tableRows.forEach(row => {
        const plat = (row.getAttribute('data-platform') || '').toLowerCase();
        const postDate = row.getAttribute('data-date') || '';

        const matchesPlatform = activePlatformFilter === 'all' || plat.includes(activePlatformFilter);
        let matchesDate = true;
        if (startDateVal && postDate < startDateVal) matchesDate = false;
        if (endDateVal && postDate > endDateVal) matchesDate = false;

        if (matchesPlatform && matchesDate) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      // Filter Gallery Cards
      const galleryCards = document.querySelectorAll('.post-card-item');
      galleryCards.forEach(card => {
        const plat = (card.getAttribute('data-platform') || '').toLowerCase();
        const postDate = card.getAttribute('data-date') || '';

        const matchesPlatform = activePlatformFilter === 'all' || plat.includes(activePlatformFilter);
        let matchesDate = true;
        if (startDateVal && postDate < startDateVal) matchesDate = false;
        if (endDateVal && postDate > endDateVal) matchesDate = false;

        if (matchesPlatform && matchesDate) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Switch Posts View Mode (Table vs Gallery)
    function switchPostsView(viewMode) {
      const btnTable = document.getElementById('btn-view-table');
      const btnGallery = document.getElementById('btn-view-gallery');
      const viewTable = document.getElementById('posts-view-table');
      const viewGallery = document.getElementById('posts-view-gallery');

      if (viewMode === 'table') {
        btnTable.className = 'px-3 py-1.5 rounded-full bg-white text-[#111113] shadow-xs font-black transition-all flex items-center gap-1.5';
        btnGallery.className = 'px-3 py-1.5 rounded-full text-gray-600 hover:text-[#111113] transition-all flex items-center gap-1.5';
        viewTable.classList.remove('hidden');
        viewGallery.classList.add('hidden');
      } else {
        btnGallery.className = 'px-3 py-1.5 rounded-full bg-white text-[#111113] shadow-xs font-black transition-all flex items-center gap-1.5';
        btnTable.className = 'px-3 py-1.5 rounded-full text-gray-600 hover:text-[#111113] transition-all flex items-center gap-1.5';
        viewGallery.classList.remove('hidden');
        viewTable.classList.add('hidden');
      }
    }

    // Toggle Notification Popover Dropdown
    function toggleNotifications() {
      const popover = document.getElementById('dropdown-notifications');
      if (popover) {
        popover.classList.toggle('hidden');
      }
    }

    // Close notification dropdown when clicking outside
    document.addEventListener('click', (e) => {
      const btn = document.getElementById('btn-notifications');
      const popover = document.getElementById('dropdown-notifications');
      if (popover && !popover.classList.contains('hidden')) {
        if (!popover.contains(e.target) && btn && !btn.contains(e.target)) {
          popover.classList.add('hidden');
        }
      }
    });
  </script>
