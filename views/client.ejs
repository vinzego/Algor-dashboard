<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= client.name %> - Marketing Analytics Dashboard</title>

  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            zdark: '#111113',
            zgray: '#F4F5F7',
            zorange: '#FF5F00',
            zorangehover: '#E05300',
            zmuted: '#6B7280'
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Apache ECharts CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>

  <!-- React 18 & ReactDOM UMD CDNs -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <!-- Babel Standalone for JSX compilation -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-[#F4F5F7] dark:bg-[#0B0B0C] min-h-screen text-[#111113] dark:text-gray-100 transition-colors duration-200">
  
  <!-- React Mount Point -->
  <div id="react-root"></div>

  <!-- Client-side React Dashboard Application -->
  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    // --- MOCK DATASETS & ACCOUNT DEFINITIONS ---
    const ACCOUNTS = [
      { id: 'acme-corp', name: 'Acme Corp', package: 'Enterprise' },
      { id: 'zellify-tech', name: 'Zellify Tech', package: 'Pro Agency' },
      { id: 'apex-studio', name: 'Apex Studio', package: 'Growth' },
      { id: 'luxe-commerce', name: 'Luxe Commerce', package: 'Scale' }
    ];

    const DATE_RANGES = [
      { id: '7d', label: 'Zadnjih 7 dana (Last 7 Days)' },
      { id: '30d', label: 'Zadnjih 30 dana (Last 30 Days)' },
      { id: 'this_month', label: 'Ovaj Mjesec (This Month)' }
    ];

    // Helper for generating dynamic daily arrays
    const getDays = (count = 14) => Array.from({ length: count }, (_, i) => `${i + 1}.08.`);

    // --- REUSABLE ECHARTS REACT COMPONENT WITH RESIZEOBSERVER ---
    const EChartComponent = ({ option, style = { width: '100%', height: '280px' } }) => {
      const chartRef = useRef(null);
      const instanceRef = useRef(null);

      useEffect(() => {
        if (!chartRef.current) return;
        if (!instanceRef.current) {
          instanceRef.current = echarts.init(chartRef.current);
        }
        instanceRef.current.setOption(option, true);

        const resizeChart = () => {
          if (instanceRef.current) {
            instanceRef.current.resize();
          }
        };

        const observer = new ResizeObserver(() => {
          resizeChart();
        });
        observer.observe(chartRef.current);

        window.addEventListener('resize', resizeChart);
        return () => {
          observer.disconnect();
          window.removeEventListener('resize', resizeChart);
        };
      }, [option]);

      return <div ref={chartRef} style={style} className="w-full min-w-0 max-w-full" />;
    };

    // --- SKELETON LOADER COMPONENT ---
    const SkeletonCard = () => (
      <div className="z-card-white dark:bg-[#161618] rounded-[2rem] p-6 animate-pulse flex flex-col justify-between h-[270px]">
        <div className="flex justify-between items-center">
          <div className="w-24 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
          <div className="w-12 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
        </div>
        <div className="w-full h-24 bg-gray-100 dark:bg-gray-800 rounded-2xl my-2"></div>
        <div className="w-32 h-6 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
      </div>
    );

    // --- MAIN REACT DASHBOARD APPLICATION ---
    function DashboardApp() {
      const [activeView, setActiveView] = useState('instagram'); // 'instagram' | 'meta-ads'
      const [selectedAccount, setSelectedAccount] = useState('acme-corp');
      const [dateRange, setDateRange] = useState('30d');
      const [isLoading, setIsLoading] = useState(false);
      const [darkMode, setDarkMode] = useState(false);

      // Table Sorting state for Instagram Posts & Meta Ads
      const [postSortKey, setPostSortKey] = useState('reach');
      const [postSortDir, setPostSortDir] = useState('desc');

      const [adSortKey, setAdSortKey] = useState('spend');
      const [adSortDir, setAdSortDir] = useState('desc');

      // Toggle Dark Mode
      useEffect(() => {
        if (darkMode) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }, [darkMode]);

      // Trigger simulated skeleton loading state when changing date or account
      const handleAccountChange = (e) => {
        setIsLoading(true);
        setSelectedAccount(e.target.value);
        setTimeout(() => setIsLoading(false), 350);
      };

      const handleDateChange = (e) => {
        setIsLoading(true);
        setDateRange(e.target.value);
        setTimeout(() => setIsLoading(false), 350);
      };

      // Current Account Details
      const accountObj = useMemo(() => {
        return ACCOUNTS.find(a => a.id === selectedAccount) || ACCOUNTS[0];
      }, [selectedAccount]);

      // --- PAGE 1: INSTAGRAM ORGANIC DATA ---
      const instagramData = useMemo(() => {
        const mult = dateRange === '7d' ? 0.35 : dateRange === 'this_month' ? 0.85 : 1.0;
        return {
          reach: Math.round(128450 * mult).toLocaleString(),
          reachChange: '+14.2%',
          impressions: Math.round(412900 * mult).toLocaleString(),
          impressionsChange: '+8.6%',
          err: '6.4%',
          errChange: '+1.1%',
          netFollowers: `+${Math.round(1380 * mult)}`,
          followersChange: '+24.5%',
          profileVisits: Math.round(14250 * mult).toLocaleString(),
          websiteTaps: Math.round(3890 * mult).toLocaleString(),
          visitsChange: '+18.3%',
          // Chart 1: Reach vs Impressions
          reachTrendOption: {
            tooltip: { trigger: 'axis' },
            legend: { data: ['Total Reach', 'Total Impressions'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
            grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
            xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
            yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
            series: [
              { name: 'Total Reach', type: 'line', data: [8200, 9400, 11200, 10800, 12500, 14100, 13800, 15200, 16800, 15900, 17400, 18600].map(v => Math.round(v * mult)), smooth: true, lineStyle: { width: 3, color: '#FF5F00' }, areaStyle: { color: 'rgba(255, 95, 0, 0.15)' }, itemStyle: { color: '#FF5F00' } },
              { name: 'Total Impressions', type: 'line', data: [24000, 27500, 31000, 29800, 34200, 38900, 37500, 41200, 44800, 42900, 46100, 49500].map(v => Math.round(v * mult)), smooth: true, lineStyle: { width: 3, color: darkMode ? '#E4E4E7' : '#111113' }, itemStyle: { color: darkMode ? '#E4E4E7' : '#111113' } }
            ]
          },
          // Chart 2: Engagement Breakdown (Saves & Shares vs Likes & Comments)
          engagementOption: {
            tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
            legend: { data: ['Saves (Core Signal)', 'Shares (Core Signal)', 'Likes', 'Comments'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
            grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
            xAxis: { type: 'category', data: ['Post #1', 'Post #2', 'Post #3', 'Post #4', 'Post #5', 'Post #6'], axisLabel: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 10 } },
            yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
            series: [
              { name: 'Saves (Core Signal)', type: 'bar', stack: 'total', data: [340, 520, 410, 680, 590, 810], itemStyle: { color: '#FF5F00' } },
              { name: 'Shares (Core Signal)', type: 'bar', stack: 'total', data: [210, 380, 290, 450, 390, 560], itemStyle: { color: darkMode ? '#E4E4E7' : '#111113' } },
              { name: 'Likes', type: 'bar', stack: 'total', data: [1200, 1850, 1420, 2100, 1950, 2600], itemStyle: { color: '#E1306C' } },
              { name: 'Comments', type: 'bar', stack: 'total', data: [180, 290, 210, 340, 280, 410], itemStyle: { color: '#1877F2', borderRadius: [4, 4, 0, 0] } }
            ]
          },
          // Chart 3: Follower Growth vs Unfollows
          growthOption: {
            tooltip: { trigger: 'axis' },
            legend: { data: ['New Follows (+)', 'Unfollows (-)', 'Net Growth Trend'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
            grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
            xAxis: { type: 'category', data: getDays(10), axisLabel: { color: '#6B7280', fontSize: 10 } },
            yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
            series: [
              { name: 'New Follows (+)', type: 'bar', data: [85, 110, 95, 140, 165, 150, 180, 210, 195, 230], itemStyle: { color: '#059669', borderRadius: [4, 4, 0, 0] } },
              { name: 'Unfollows (-)', type: 'bar', data: [-18, -24, -20, -32, -28, -25, -30, -35, -29, -38], itemStyle: { color: '#EF4444', borderRadius: [0, 0, 4, 4] } },
              { name: 'Net Growth Trend', type: 'line', data: [67, 86, 75, 108, 137, 125, 150, 175, 166, 192], smooth: true, lineStyle: { width: 3, color: '#FF5F00' }, itemStyle: { color: '#FF5F00' } }
            ]
          },
          // Posts Table Data
          posts: [
            { id: 1, thumb: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=120&fit=crop', caption: 'Ljetni popust 20% na sve usluge! 🚀', type: 'Reel', reach: 42100, likes: 3200, comments: 240, saves: 890, shares: 640 },
            { id: 2, thumb: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=120&fit=crop', caption: 'Vodič kroz marketing strategiju u 2026. 📊', type: 'Carousel', reach: 31400, likes: 2450, comments: 180, saves: 1120, shares: 480 },
            { id: 3, thumb: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=120&fit=crop', caption: 'Kako doći do više konverzija uz Meta Ads? 💡', type: 'Reel', reach: 28900, likes: 2100, comments: 165, saves: 740, shares: 390 },
            { id: 4, thumb: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=120&fit=crop', caption: 'Priča iza našeg najnovijeg projekta 🔥', type: 'Single Image', reach: 19800, likes: 1450, comments: 95, saves: 310, shares: 180 },
            { id: 5, thumb: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=120&fit=crop', caption: 'Top 5 grešaka u dizajnu oglasa ❌', type: 'Carousel', reach: 24600, likes: 1920, comments: 140, saves: 850, shares: 420 }
          ]
        };
      }, [dateRange, darkMode]);

      // Sorted Posts Table Data
      const sortedPosts = useMemo(() => {
        const list = [...instagramData.posts];
        list.sort((a, b) => {
          let valA = a[postSortKey];
          let valB = b[postSortKey];
          if (postSortKey === 'err') {
            valA = ((a.likes + a.comments + a.saves + a.shares) / a.reach) * 100;
            valB = ((b.likes + b.comments + b.saves + b.shares) / b.reach) * 100;
          }
          if (valA < valB) return postSortDir === 'asc' ? -1 : 1;
          if (valA > valB) return postSortDir === 'asc' ? 1 : -1;
          return 0;
        });
        return list;
      }, [instagramData.posts, postSortKey, postSortDir]);

      const handlePostSort = (key) => {
        if (postSortKey === key) {
          setPostSortDir(postSortDir === 'asc' ? 'desc' : 'asc');
        } else {
          setPostSortKey(key);
          setPostSortDir('desc');
        }
      };

      // --- PAGE 2: META ADS PERFORMANCE DATA ---
      const metaAdsData = useMemo(() => {
        const mult = dateRange === '7d' ? 0.35 : dateRange === 'this_month' ? 0.85 : 1.0;
        return {
          spend: `$${(4850.00 * mult).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`,
          spendChange: '+5.4%',
          roas: '4.25x',
          roasChange: '+0.4x',
          cpa: `$${(14.20).toFixed(2)}`,
          cpaChange: '-8.5%', // lower CPA is better
          conversions: `${Math.round(341 * mult)} Leads`,
          conversionsChange: '+15.2%',
          ctr: '2.84%',
          ctrChange: '+0.3%',
          // Chart 1: Spend vs ROAS (Dual Y-Axis)
          spendRoasOption: {
            tooltip: { trigger: 'axis' },
            legend: { data: ['Daily Spend ($)', 'Blended ROAS (x)'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
            grid: { top: 30, bottom: 40, left: 15, right: 15, containLabel: true },
            xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
            yAxis: [
              { type: 'value', name: 'Spend ($)', axisLabel: { color: '#6B7280', fontSize: 10, formatter: '${value}' } },
              { type: 'value', name: 'ROAS (x)', min: 0, max: 6, axisLabel: { color: '#FF5F00', fontSize: 10, formatter: '{value}x' } }
            ],
            series: [
              { name: 'Daily Spend ($)', type: 'bar', barWidth: '35%', data: [210, 240, 280, 310, 290, 340, 420, 390, 450, 480, 460, 520].map(v => Math.round(v * mult)), itemStyle: { color: darkMode ? '#3F3F46' : '#111113', borderRadius: [4, 4, 0, 0] } },
              { name: 'Blended ROAS (x)', type: 'line', yAxisIndex: 1, data: [4.8, 4.6, 4.3, 3.9, 4.2, 4.5, 3.8, 4.1, 4.4, 4.2, 4.5, 4.3], smooth: true, lineStyle: { width: 3, color: '#FF5F00' }, itemStyle: { color: '#FF5F00' } }
            ]
          },
          // Chart 2: Creative Health & Ad Fatigue (Frequency vs CTR Link)
          fatigueOption: {
            tooltip: { trigger: 'axis' },
            legend: { data: ['Ad Frequency', 'CTR Link (%)'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
            grid: { top: 30, bottom: 40, left: 15, right: 15, containLabel: true },
            xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
            yAxis: [
              { type: 'value', name: 'Frequency', min: 1, max: 5, axisLabel: { color: '#EF4444', fontSize: 10, formatter: '{value}x' } },
              { type: 'value', name: 'CTR (%)', min: 0, max: 5, axisLabel: { color: '#059669', fontSize: 10, formatter: '{value}%' } }
            ],
            series: [
              { name: 'Ad Frequency', type: 'line', data: [1.4, 1.7, 2.1, 2.4, 2.8, 3.1, 3.4, 3.7, 4.0, 4.2, 4.5, 4.8], smooth: true, lineStyle: { width: 3, color: '#EF4444' }, itemStyle: { color: '#EF4444' } },
              { name: 'CTR Link (%)', type: 'line', yAxisIndex: 1, data: [3.8, 3.6, 3.4, 3.1, 2.8, 2.4, 2.1, 1.8, 1.5, 1.3, 1.1, 0.9], smooth: true, lineStyle: { width: 3, color: '#059669' }, itemStyle: { color: '#059669' } }
            ]
          },
          // Chart 3: Funnel Leakage (Link Clicks vs Landing Page Views)
          funnelOption: {
            tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
            legend: { data: ['Outbound Link Clicks', 'Verified Landing Page Views'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
            grid: { top: 20, bottom: 45, left: 15, right: 15, containLabel: true },
            xAxis: { type: 'category', data: ['Tjedan 1', 'Tjedan 2', 'Tjedan 3', 'Tjedan 4'], axisLabel: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
            yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
            series: [
              { name: 'Outbound Link Clicks', type: 'bar', barWidth: '35%', data: [1240, 1480, 1620, 1850].map(v => Math.round(v * mult)), itemStyle: { color: '#1877F2', borderRadius: [4, 4, 0, 0] } },
              { name: 'Verified Landing Page Views', type: 'bar', barWidth: '35%', data: [940, 1120, 1210, 1380].map(v => Math.round(v * mult)), itemStyle: { color: '#FF5F00', borderRadius: [4, 4, 0, 0] } }
            ]
          },
          // Chart 4: Video Creative Retention (Hook Rate vs Hold Rate)
          retentionOption: {
            tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
            legend: { data: ['Hook Rate (3s Views / Impressions %)', 'Hold Rate (ThruPlays / 3s Views %)'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
            grid: { top: 20, bottom: 45, left: 10, right: 20, containLabel: true },
            xAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10, formatter: '{value}%' } },
            yAxis: { type: 'category', data: ['Ad 1: Ljetni Popust', 'Ad 2: Vodič Strategija', 'Ad 3: Demo Proizvoda', 'Ad 4: Klijent Review'], axisLabel: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
            series: [
              { name: 'Hook Rate (3s Views / Impressions %)', type: 'bar', barWidth: '30%', data: [44.2, 38.5, 51.0, 31.4], itemStyle: { color: '#FF5F00', borderRadius: [0, 4, 4, 0] } },
              { name: 'Hold Rate (ThruPlays / 3s Views %)', type: 'bar', barWidth: '30%', data: [28.4, 22.1, 35.8, 19.2], itemStyle: { color: darkMode ? '#E4E4E7' : '#111113', borderRadius: [0, 4, 4, 0] } }
            ]
          },
          // Chart 5: Platform & Placement Breakdown
          placementOption: {
            tooltip: { trigger: 'item', formatter: '{b}: ${c} ({d}%)' },
            legend: { bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
            series: [{
              name: 'Potrošnja po Plasmanu',
              type: 'pie',
              radius: ['45%', '70%'],
              avoidLabelOverlap: false,
              itemStyle: { borderRadius: 10, borderColor: darkMode ? '#161618' : '#ffffff', borderWidth: 2 },
              data: [
                { value: Math.round(1850 * mult), name: 'Instagram Feed', itemStyle: { color: '#E1306C' } },
                { value: Math.round(1420 * mult), name: 'Instagram Reels', itemStyle: { color: '#FF5F00' } },
                { value: Math.round(1120 * mult), name: 'Facebook Feed', itemStyle: { color: '#1877F2' } },
                { value: Math.round(460 * mult), name: 'Instagram Stories', itemStyle: { color: '#833AB4' } }
              ]
            }]
          },
          // Ads Table Leaderboard
          ads: [
            { id: 1, name: 'Ljetni Popust 20% Video', placement: 'IG Reels', spend: 1420.00, ctr: 3.42, cpa: 12.40, roas: 4.8, hookRate: 44.2, views3s: 14200, impressions: 32100, status: 'Active' },
            { id: 2, name: 'Retargeting Napuštene Košarice', placement: 'FB Feed', spend: 1180.00, ctr: 2.85, cpa: 14.10, roas: 4.1, hookRate: 38.5, views3s: 9800, impressions: 25400, status: 'Active' },
            { id: 3, name: 'Lookalike 1% KUPCI Karusel', placement: 'IG Feed', spend: 950.00, ctr: 2.41, cpa: 16.80, roas: 3.5, hookRate: 31.0, views3s: 6400, impressions: 20600, status: 'Active' },
            { id: 4, name: 'Digital Marketing Vodič Storitve', placement: 'IG Stories', spend: 460.00, ctr: 1.95, cpa: 19.20, roas: 2.8, hookRate: 28.4, views3s: 4100, impressions: 14500, status: 'Paused' }
          ]
        };
      }, [dateRange, darkMode]);

      // Sorted Ads Leaderboard
      const sortedAds = useMemo(() => {
        const list = [...metaAdsData.ads];
        list.sort((a, b) => {
          let valA = a[adSortKey];
          let valB = b[adSortKey];
          if (valA < valB) return adSortDir === 'asc' ? -1 : 1;
          if (valA > valB) return adSortDir === 'asc' ? 1 : -1;
          return 0;
        });
        return list;
      }, [metaAdsData.ads, adSortKey, adSortDir]);

      const handleAdSort = (key) => {
        if (adSortKey === key) {
          setAdSortDir(adSortDir === 'asc' ? 'desc' : 'asc');
        } else {
          setAdSortKey(key);
          setAdSortDir('desc');
        }
      };

      return (
        <div className="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
          
          {/* TOP HEADER WITH CONTROLS & NAVIGATION */}
          <header className="mb-8">
            {/* TOP BAR: BRAND + SELECTORS + THEME TOGGLE */}
            <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-gray-200 dark:border-gray-800">
              
              {/* Brand Logo & Tenant Badge */}
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-2xl bg-[#111113] text-white flex items-center justify-center font-black text-lg shadow-md border border-white/10">
                  <i className="fa-solid fa-bolt-lightning text-zorange"></i>
                </div>
                <div>
                  <h1 className="text-2xl font-black tracking-tight text-[#111113] dark:text-white flex items-center gap-1.5">
                    ZELLIFY<span className="text-zorange">.</span>
                    <span className="text-xs font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-orange-100 dark:bg-orange-950/60 text-zorange border border-orange-200 dark:border-orange-900">Agency Edition</span>
                  </h1>
                  <p className="text-xs text-gray-500 font-semibold">Client Marketing Analytics System</p>
                </div>
              </div>

              {/* Center Capsule Navigation Switcher (Instagram Organic vs Meta Ads Performance) */}
              <div className="z-pill-nav flex items-center gap-1 self-start lg:self-auto">
                <button 
                  onClick={() => setActiveView('instagram')} 
                  className={`px-5 py-2.5 text-xs font-black uppercase tracking-wider transition-all duration-200 flex items-center gap-2 ${
                    activeView === 'instagram' 
                      ? 'bg-white text-[#111113] rounded-full shadow-md' 
                      : 'text-white/80 hover:text-white'
                  }`}
                >
                  <i className="fa-brands fa-instagram text-pink-500 text-sm"></i>
                  Instagram Organic
                </button>
                <button 
                  onClick={() => setActiveView('meta-ads')} 
                  className={`px-5 py-2.5 text-xs font-black uppercase tracking-wider transition-all duration-200 flex items-center gap-2 ${
                    activeView === 'meta-ads' 
                      ? 'bg-white text-[#111113] rounded-full shadow-md' 
                      : 'text-white/80 hover:text-white'
                  }`}
                >
                  <i className="fa-brands fa-meta text-blue-500 text-sm"></i>
                  Meta Ads Performance
