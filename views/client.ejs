  <!-- Client-side tab switching and ECharts initialization scripts -->
  <script>
    const clientPackage = '<%= client.package %>';
    const chartData = <%- JSON.stringify(client.chartData) %>;
    const googleChartData = <%- JSON.stringify(client.googleChartData) %>;
    const clientId = '<%= client.id %>';
    
    // ECharts Instances
    let mfrGaugeChart, revenueSparklineChart, subscribersBarChart, revenueHighlightedChart;
    let efficiencyChart, platformsChart, audienceChart, postsChart, reachChart;
    let googleEfficiencyChart, googleNetworksChart;
    let tiktokEfficiencyChart, tiktokVideosChart;
    let blendedChart, fatigueChart, daypartingChart, ltvChart;
    let socialPlatformsChart, socialFormatsChart;

    // Main Tab Switching (Meta vs Meta Ads)
    function switchMainTab(tab) {
      const btnMeta = document.getElementById('btn-tab-meta');
      const btnMetaAds = document.getElementById('btn-tab-meta-ads');
      const panelMeta = document.getElementById('panel-advanced-analytics');
      const panelMetaAds = document.getElementById('panel-meta-ads');

      if (tab === 'meta') {
