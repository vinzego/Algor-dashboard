                </div>
                <div class="w-9 h-9 rounded-xl bg-brand-cyan/25 border border-brand-cyan/50 flex items-center justify-center text-brand-dark text-base">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
              </div>
              <div class="w-full bg-brand-dark/10 rounded-full h-2.5 overflow-hidden">
                <div class="bg-brand-dark h-2.5 rounded-full" style="width: <%= client.socialMediaStats.progressPercent %>%;"></div>
              </div>
