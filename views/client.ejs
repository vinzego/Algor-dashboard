                    className="p-3 rounded-2xl bg-gray-50 dark:bg-gray-800/60 hover:bg-orange-50 dark:hover:bg-orange-950/40 border border-gray-200/80 dark:border-gray-700 text-[#111113] dark:text-white font-bold text-left flex items-center justify-between cursor-pointer"
                  >
                    <span>15.08. do 21.08.</span>
                    <span className="text-[10px] text-orange-500 font-extrabold">Tjedan 3</span>
                  </button>

                  <button 
                    onClick={() => { setCalendarStartDay(1); setCalendarEndDay(31); setDateSelectionMode('month'); setDateRange('30d'); setIsCustomCalendarModalOpen(false); }}
                    className="p-3 rounded-2xl bg-gray-50 dark:bg-gray-800/60 hover:bg-orange-50 dark:hover:bg-orange-950/40 border border-gray-200/80 dark:border-gray-700 text-[#111113] dark:text-white font-bold text-left flex items-center justify-between cursor-pointer"
                  >
                    <span>Cijeli Mjesec</span>
                    <span className="text-[10px] text-orange-500 font-extrabold">01.-31.08.</span>
                  </button>
                </div>

                {/* CURRENT RANGE DISPLAY & CONFIRM BUTTON */}
                <div className="p-4 rounded-2xl bg-orange-50 dark:bg-orange-950/30 border border-orange-200 dark:border-orange-900/50 space-y-2 text-center">
                  <span className="text-[10px] font-black uppercase tracking-wider text-orange-600 dark:text-orange-400 block">Trenutno Odabrani Raspon:</span>
                  <p className="text-sm font-black text-[#111113] dark:text-white">
                    {String(calendarStartDay).padStart(2, '0')}.${String(activeMonthIndex + 1).padStart(2, '0')}.2026. — {String(calendarEndDay).padStart(2, '0')}.${String(activeMonthIndex + 1).padStart(2, '0')}.2026.
                  </p>
                </div>

                <div className="flex gap-2">
                  <button 
                    onClick={() => { setCalendarStartDay(1); setCalendarEndDay(31); setDateSelectionMode('month'); setDateRange('30d'); setIsCustomCalendarModalOpen(false); }}
                    className="flex-1 py-3 rounded-2xl bg-gray-100 dark:bg-gray-800 text-[#111113] dark:text-white hover:bg-gray-200 text-xs font-black uppercase tracking-wider transition-all cursor-pointer"
                  >
                    Prikaži Cijeli Mjesec
                  </button>
                  <button 
                    onClick={() => { setIsCustomCalendarModalOpen(false); }}
                    className="flex-1 py-3 rounded-2xl bg-[#111113] text-white dark:bg-white dark:text-[#111113] text-xs font-black uppercase tracking-wider transition-all shadow-md cursor-pointer hover:bg-orange-500 hover:text-white"
                  >
                    Primijeni Raspon
                  </button>
                </div>

              </div>
            </div>
          )}

        </div>
        </div>
      );
    }

    // Render React App
    const root = ReactDOM.createRoot(document.getElementById('react-root'));
    root.render(<DashboardApp />);
  </script>
</body>
</html>
