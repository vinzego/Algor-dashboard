            <!-- Card 2: Total Impressions -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[150px] shadow-sm sm:col-span-6 xl:col-span-3">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Ukupno impresija objava</p>
                  <h3 class="text-2xl font-black text-brand-dark mt-1.5"><%= client.socialMediaStats.totalImpressions %></h3>
                </div>
                <div class="w-9 h-9 rounded-xl bg-brand-green/30 border border-brand-green/50 flex items-center justify-center text-brand-dark text-base">
                  <i class="fa-solid fa-eye"></i>
                </div>
              </div>
              <div class="text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2 flex justify-between">
                <span>Organski doseg:</span>
                <span class="font-extrabold text-brand-dark"><%= client.socialMediaStats.totalReach %></span>
              </div>
            </div>

            <!-- Card 3: Total Engagements -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[150px] shadow-sm sm:col-span-6 xl:col-span-3">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Reakcije i interakcije</p>
                  <h3 class="text-2xl font-black text-brand-dark mt-1.5"><%= client.socialMediaStats.totalEngagements %></h3>
                </div>
                <div class="w-9 h-9 rounded-xl bg-brand-pink/30 border border-brand-pink/50 flex items-center justify-center text-brand-dark text-base">
                  <i class="fa-solid fa-heart"></i>
                </div>
              </div>
              <div class="text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2 flex justify-between">
                <span>Lajkovi + Komentari + Shares</span>
                <span class="font-extrabold text-brand-dark">Aktivno</span>
              </div>
            </div>

            <!-- Card 4: Avg Engagement Rate -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[150px] shadow-sm sm:col-span-6 xl:col-span-3">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Engagement Rate (Stopa)</p>
                  <h3 class="text-2xl font-black text-emerald-800 mt-1.5"><%= client.socialMediaStats.avgEngagementRate %></h3>
                </div>
                <div class="w-9 h-9 rounded-xl bg-emerald-100 border border-emerald-300 flex items-center justify-center text-emerald-900 text-base">
                  <i class="fa-solid fa-bolt"></i>
                </div>
              </div>
              <div class="text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2 flex justify-between">
                <span>Prosjek industrije: ~2.5%</span>
                <span class="font-extrabold text-emerald-800">Iznad prosjeka</span>
              </div>
            </div>
          </div>

          <!-- SOCIAL MEDIA CHARTS ROW -->
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 mb-8">
            <!-- Chart 1: Platform Views Breakdown (Instagram vs Facebook vs TikTok) -->
            <div class="xl:col-span-6 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Pregledi objava po platformama</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Instagram / Facebook / TikTok</span>
              </div>
              <div id="social-chart-platforms" class="w-full" style="height: 280px;"></div>
            </div>

            <!-- Chart 2: Format Performance (Reels vs Carousels vs Images) -->
            <div class="xl:col-span-6 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Učinkovitost po formatu objava</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Prosječni pregledi po vrsti sadržaja</span>
              </div>
              <div id="social-chart-formats" class="w-full" style="height: 280px;"></div>
            </div>
          </div>

          <!-- VISUAL CREATIVE GALLERY - OBJAVE S SLIKOM I ANALITIKOM -->
          <div class="mb-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
              <h4 class="text-lg font-black text-brand-dark uppercase tracking-wider flex items-center gap-2">
                <i class="fa-solid fa-images text-brand-dark"></i> Vizualni pregled svih objavljenih kreativa
              </h4>
              <span class="text-xs font-bold text-brand-dark/75 uppercase bg-brand-dark/10 px-3 py-1 rounded-full border border-brand-dark/15">
                Ukupno objavljeno: <%= client.socialMediaStats.creatives.length %> objava
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              <% client.socialMediaStats.creatives.forEach(post => { %>
                <div class="glass-panel rounded-[1.75rem] overflow-hidden shadow-md border border-brand-dark/15 flex flex-col justify-between transition-transform duration-300 hover:-translate-y-1">
                  
                  <!-- Creative Image Header Container -->
                  <div class="relative h-56 w-full overflow-hidden bg-brand-dark/10 group">
                    <img src="<%= post.imageUrl %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    
                    <!-- Gradient Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/30 to-transparent"></div>
                    
                    <!-- Top Badges Overlay -->
                    <div class="absolute top-3 left-3 right-3 flex justify-between items-center gap-2">
                      <span class="px-2.5 py-1 rounded-full text-xs font-black uppercase bg-white/95 text-brand-dark shadow-sm border border-brand-dark/20 flex items-center gap-1.5">
                        <i class="<%= post.platformIcon %>"></i> <%= post.platform %>
                      </span>
                      <span class="px-2.5 py-1 rounded-full text-xs font-black uppercase shadow-sm border <%= post.badgeClass %>">
                        <%= post.badge %>
                      </span>
                    </div>

                    <!-- Bottom Title & Format Overlay -->
                    <div class="absolute bottom-3 left-3 right-3 text-white">
                      <span class="text-[10px] font-extrabold uppercase tracking-wider bg-black/40 backdrop-blur-sm px-2 py-0.5 rounded text-white/90 mb-1 inline-block border border-white/20">
                        <%= post.type %> • <%= post.date %>
                      </span>
                      <h5 class="text-base font-black leading-snug drop-shadow-md"><%= post.title %></h5>
                    </div>
                  </div>

                  <!-- Creative Performance Stats Grid -->
                  <div class="p-5">
                    <div class="grid grid-cols-3 gap-2 bg-brand-dark/5 p-3 rounded-2xl text-center mb-4 border border-brand-dark/10">
                      <div>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/60">👁️ Pregledi</span>
                        <span class="font-black text-sm text-brand-dark"><%= post.impressions %></span>
                      </div>
                      <div>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/60">👤 Doseg</span>
                        <span class="font-black text-sm text-brand-dark"><%= post.reach %></span>
                      </div>
                      <div>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-dark/60">⚡ Eng. Rate</span>
                        <span class="font-black text-sm <%= post.rank === 'top' ? 'text-emerald-800' : (post.rank === 'bottom' ? 'text-amber-900' : 'text-brand-dark') %>"><%= post.engagementRate %></span>
                      </div>
                    </div>

                    <!-- Detail Interactions -->
                    <div class="flex justify-around items-center text-xs font-bold text-brand-dark/80 pb-3 border-b border-brand-dark/10">
                      <span class="flex items-center gap-1"><i class="fa-solid fa-heart text-rose-500"></i> <%= post.likes %> lajkova</span>
                      <span class="flex items-center gap-1"><i class="fa-solid fa-comment text-sky-600"></i> <%= post.comments %> komentara</span>
                      <span class="flex items-center gap-1"><i class="fa-solid fa-share text-emerald-600"></i> <%= post.shares %> dijeljenja</span>
                    </div>

                    <!-- Note / Performance Feedback Box -->
                    <div class="mt-3.5 p-3 rounded-xl text-xs font-bold leading-relaxed border <%= post.rank === 'top' ? 'bg-emerald-50 text-emerald-900 border-emerald-200' : (post.rank === 'bottom' ? 'bg-amber-50 text-amber-900 border-amber-200' : 'bg-white/80 text-brand-dark border-brand-dark/15') %>">
                      <% if (post.rank === 'top') { %>
                        💡 <strong>Zašto je uspješna:</strong> <%= post.note %>
                      <% } else if (post.rank === 'bottom') { %>
                        🛠️ <strong>Savjet za optimizaciju:</strong> <%= post.note %>
                      <% } else { %>
                        📌 <strong>Uvid:</strong> <%= post.note %>
                      <% } %>
                    </div>
                  </div>

                </div>
              <% }); %>
            </div>
          </div>

        </section>

      </main>

      <!-- RIGHT COLUMN: AI Assistant Sidebar (20% of width) -->
      <aside class="w-full lg:w-[24%] xl:w-[21%] flex flex-col h-[calc(100vh-140px)] sticky top-28 glass-panel rounded-[2rem] shadow-lg overflow-hidden border border-brand-dark/15">
        
        <!-- Chat Header -->
        <div class="flex items-center justify-between p-4 border-b border-brand-dark/15 bg-white/40">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-brand-cyan to-brand-green flex items-center justify-center shadow-sm">
              <i class="fa-solid fa-wand-magic-sparkles text-xs text-brand-dark"></i>
            </div>
            <h4 class="text-xs md:text-sm font-black text-brand-dark uppercase tracking-wider">AI Asistent</h4>
          </div>
          <span class="inline-flex items-center gap-1 text-xs font-black px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-300">
            Online
          </span>
        </div>

        <!-- Chat History Log -->
        <div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 text-xs md:text-sm scrollbar-thin">
          <!-- Initial Assistant Message -->
          <div class="flex items-start gap-2.5 max-w-[88%]">
            <div class="w-8 h-8 rounded-lg bg-brand-dark/10 flex items-center justify-center border border-brand-dark/15 shrink-0">
              <i class="fa-solid fa-robot text-brand-dark text-xs"></i>
            </div>
            <div class="glass-panel p-3.5 rounded-2xl rounded-tl-none text-brand-dark font-medium shadow-sm leading-relaxed border border-brand-dark/15">
              Pozdrav! Ja sam tvoj integrirani marketinški AI asistent za klijenta <strong><%= client.name %></strong>.
              Imam uvid u sve brojeve, PMax kampanje, Meta oglase i objave na društvenim mrežama. Pitaj me kako poboljšati rezultate!
            </div>
          </div>
        </div>

        <!-- Chat Input Form & Suggestions -->
        <div class="p-3.5 border-t border-brand-dark/15 bg-white/30">
          <!-- Suggestion Chips -->
          <div id="suggestion-container" class="flex flex-wrap gap-1.5 mb-2.5">
            <button onclick="sendSuggestion('Što ne valja i kako to popraviti?')" class="text-xs font-black text-rose-950 bg-rose-100 hover:bg-rose-200 border border-rose-300 px-2.5 py-1 rounded-full transition-all duration-300 shadow-sm">
              🔴 Što ne valja i kako popraviti?
            </button>
            <button onclick="sendSuggestion('Kako optimizirati Google PMax kampanju?')" class="text-xs font-bold text-brand-dark/90 hover:text-brand-dark bg-white/90 hover:bg-white border border-brand-dark/20 px-2.5 py-1 rounded-full transition-all duration-300 shadow-sm">
              🔍 Optimiziraj PMax
            </button>
            <button onclick="sendSuggestion('Kako riješiti zamor Meta Kreative #4?')" class="text-xs font-bold text-brand-dark/90 hover:text-brand-dark bg-white/90 hover:bg-white border border-brand-dark/20 px-2.5 py-1 rounded-full transition-all duration-300 shadow-sm">
              🎯 Riješi zamor Meta oglasa
            </button>
            <button onclick="sendSuggestion('Daj mi preporuku za Mjesečni plan objava')" class="text-xs font-bold text-brand-dark/90 hover:text-brand-dark bg-white/90 hover:bg-white border border-brand-dark/20 px-2.5 py-1 rounded-full transition-all duration-300 shadow-sm">
              📸 Plan objava i kreativa
            </button>
          </div>

          <!-- Input Area -->
          <form id="chat-form" onsubmit="handleChatSubmit(event)" class="relative flex items-center">
            <textarea 
              id="chat-input" 
              rows="1" 
              placeholder="Pitaj me nešto..." 
              class="w-full bg-white/80 border border-brand-dark/20 rounded-2xl pl-4 pr-10 py-2.5 text-xs md:text-sm font-semibold text-brand-dark placeholder-brand-dark/60 focus:outline-none focus:ring-2 focus:ring-brand-cyan/60 resize-none overflow-y-hidden h-[42px] transition-all shadow-sm"
              oninput="adjustInputHeight(this)"
              onkeydown="handleInputKeydown(event)"
            ></textarea>
            <button 
              type="submit" 
              class="absolute right-3.5 top-1/2 -translate-y-1/2 text-brand-dark hover:scale-110 transition-transform"
            >
              <i class="fa-solid fa-paper-plane text-sm"></i>
            </button>
          </form>
        </div>

      </aside>

    </div>

  </div>

  <!-- Client-side tab switching and ECharts + SSE Chat scripts -->
  <script>
    // Load chartData passed from express server
    const clientPackage = '<%= client.package %>';
    const chartData = <%- JSON.stringify(client.chartData) %>;
    const googleChartData = <%- JSON.stringify(client.googleChartData) %>;
    const clientId = '<%= client.id %>';
    let conversationHistory = []; // Tracks chat messages for multi-turn context
    
    // Meta Charts
    let efficiencyChart, platformsChart, audienceChart, postsChart, reachChart;
    // Google Charts
    let googleEfficiencyChart, googlePacingChart, googleNetworksChart, googleCampaignsChart, googleDevicesLocationsChart, googleFunnelChart;
    // TikTok Charts (Ultra Package Exclusive)
    let tiktokEfficiencyChart, tiktokVideosChart;
    // Advanced Decision Analytics Charts
    let blendedChart, fatigueChart, daypartingChart, ltvChart;
    // Social Media Content Charts
    let socialPlatformsChart, socialFormatsChart;

    // Helper to initialize ECharts
    document.addEventListener('DOMContentLoaded', () => {
      initCharts();
    });

    function initCharts() {
      /* ----------------------------------------------------
         META ADS ECHARTS SETUP
         ---------------------------------------------------- */
      efficiencyChart = echarts.init(document.getElementById('meta-chart-efficiency'));
      efficiencyChart.setOption({
        tooltip: { trigger: 'axis', axisPointer: { type: 'cross' } },
        legend: {
          data: ['Dnevni trošak', 'Konverzije'],
          textStyle: { fontFamily: 'Urbanist', color: '#122022', fontWeight: 700, fontSize: 12 }
        },
        grid: { left: '3%', right: '3%', bottom: '3%', containLabel: true },
        xAxis: {
          type: 'category',
          data: chartData.days,
          axisLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.2)' } },
          axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 }
        },
        yAxis: [
          {
            type: 'value',
            name: 'Trošak ($)',
            axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 },
            splitLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.08)' } }
          },
          {
            type: 'value',
            name: 'Konverzije',
            axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 },
            splitLine: { show: false }
          }
        ],
        series: [
          {
            name: 'Dnevni trošak',
            type: 'line',
            data: chartData.spendDaily,
            smooth: true,
            symbol: 'circle',
            symbolSize: 6,
            lineStyle: { width: 3 },
            itemStyle: { color: '#00796B' }
          },
          {
            name: 'Konverzije',
            type: 'line',
            yAxisIndex: 1,
            data: chartData.conversionsDaily,
            smooth: true,
            symbol: 'circle',
            symbolSize: 6,
            lineStyle: { width: 3 },
            itemStyle: { color: '#D81B60' }
          }
        ]
      });

      platformsChart = echarts.init(document.getElementById('meta-chart-platforms'));
      platformsChart.setOption({
        tooltip: { trigger: 'item', formatter: '{b}: ${c} ({d}%)' },
        legend: {
          bottom: '0',
          left: 'center',
          textStyle: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.9)', fontWeight: 700, fontSize: 12 }
        },
        series: [
          {
            name: 'Potrošnja',
            type: 'pie',
            radius: ['45%', '70%'],
            avoidLabelOverlap: false,
            itemStyle: { borderRadius: 10, borderColor: '#ffffff', borderWidth: 2 },
            label: { show: false, position: 'center' },
            emphasis: {
              label: {
                show: true,
                fontSize: 15,
                fontWeight: 'bold',
                fontFamily: 'Urbanist',
                formatter: '{b}\n{d}%'
              }
            },
            labelLine: { show: false },
            data: chartData.platforms,
            color: ['#96D8D0', '#F1B4B9', '#DAF4AA']
          }
        ]
      });

      audienceChart = echarts.init(document.getElementById('meta-chart-audience'));
      audienceChart.setOption({
        tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
        grid: { left: '3%', right: '5%', bottom: '3%', containLabel: true },
        xAxis: {
          type: 'value',
          splitLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.08)' } },
          axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 }
        },
        yAxis: {
          type: 'category',
          data: [...chartData.audienceCategories].reverse(),
          axisLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.2)' } },
          axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.95)', fontWeight: 700, fontSize: 12 }
        },
        series: [
          {
            name: 'Konverzije',
            type: 'bar',
            data: [...chartData.audienceValues].reverse(),
            itemStyle: {
              borderRadius: [0, 5, 5, 0],
              color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                { offset: 0, color: '#96D8D0' },
                { offset: 1, color: '#DAF4AA' }
              ])
            }
          }
        ]
      });

      postsChart = echarts.init(document.getElementById('meta-chart-posts'));
      postsChart.setOption({
        tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
        legend: {
          data: ['Lajkovi', 'Komentari', 'Dijeljenja'],
          bottom: '0',
          textStyle: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.9)', fontWeight: 700, fontSize: 12 }
        },
        grid: { left: '3%', right: '5%', bottom: '10%', containLabel: true },
        xAxis: {
          type: 'value',
          splitLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.08)' } },
          axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 }
        },
        yAxis: {
          type: 'category',
          data: [...chartData.topPostsTitles].reverse(),
          axisLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.2)' } },
          axisLabel: { 
            fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.95)', fontWeight: 700, fontSize: 12,
            formatter: function(value) { return value.length > 14 ? value.slice(0, 11) + '...' : value; }
          }
        },
        series: [
          { name: 'Lajkovi', type: 'bar', stack: 'engagement', data: [...chartData.topPostsLikes].reverse(), itemStyle: { color: '#96D8D0' } },
          { name: 'Komentari', type: 'bar', stack: 'engagement', data: [...chartData.topPostsComments].reverse(), itemStyle: { color: '#F1B4B9' } },
          { name: 'Dijeljenja', type: 'bar', stack: 'engagement', data: [...chartData.topPostsShares].reverse(), itemStyle: { borderRadius: [0, 3, 3, 0], color: '#DAF4AA' } }
        ]
      });

      reachChart = echarts.init(document.getElementById('meta-chart-reach'));
      reachChart.setOption({
        tooltip: { trigger: 'axis' },
        grid: { left: '3%', right: '3%', bottom: '3%', containLabel: true },
        xAxis: {
          type: 'category',
          boundaryGap: false,
          data: chartData.days,
          axisLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.2)' } },
          axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 }
        },
        yAxis: {
          type: 'value',
          splitLine: { lineStyle: { color: 'rgba(18, 32, 34, 0.08)' } },
          axisLabel: { fontFamily: 'Urbanist', color: 'rgba(18, 32, 34, 0.85)', fontWeight: 600, fontSize: 11 }
        },
        series: [
          {
            name: 'Organski doseg',
            type: 'line',
            data: chartData.organicReachDaily,
            smooth: true,
