    // Tab switching logic (Enforces package locks!)
    function switchPlatform(platform) {
      const btnMeta = document.getElementById('btn-meta');
      const btnGoogle = document.getElementById('btn-google');
      const btnTiktok = document.getElementById('btn-tiktok');
      
      const panelMeta = document.getElementById('panel-meta');
      const panelGoogle = document.getElementById('panel-google');
      const panelTiktok = document.getElementById('panel-tiktok');
      const panelLocked = document.getElementById('panel-locked');
      
      const platformTitleBadge = document.getElementById('platform-title-badge');
      const lockedText = document.getElementById('locked-panel-text');

      // Helper reset
      const panels = [panelMeta, panelGoogle, panelTiktok, panelLocked];
      panels.forEach(p => {
        if (p) {
          p.classList.add('hidden');
          p.classList.remove('opacity-100', 'scale-100');
          p.classList.add('opacity-0', 'scale-95');
        }
      });

      // Button resets
      const buttons = [btnMeta, btnGoogle, btnTiktok];
      buttons.forEach(b => {
        if (b) b.className = 'px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 text-brand-dark/60 hover:text-brand-dark flex items-center gap-1';
      });
      btnMeta.className = 'px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 text-brand-dark/60 hover:text-brand-dark';

      // 1. Meta Ads (always unlocked)
      if (platform === 'meta') {
        btnMeta.className = 'px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 bg-brand-dark text-white shadow-sm';
        platformTitleBadge.textContent = 'Meta Ads';
        
        panelMeta.classList.remove('hidden');
        setTimeout(() => {
          panelMeta.classList.remove('opacity-0', 'scale-95');
          panelMeta.classList.add('opacity-100', 'scale-100');
          if (efficiencyChart) efficiencyChart.resize();
          if (platformsChart) platformsChart.resize();
          if (audienceChart) audienceChart.resize();
          if (postsChart) postsChart.resize();
          if (reachChart) reachChart.resize();
        }, 50);
      }
      
      // 2. Google Ads (locked for Start package)
      else if (platform === 'google') {
        btnGoogle.className = 'px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 bg-brand-dark text-white shadow-sm flex items-center gap-1';
        platformTitleBadge.textContent = 'Google Ads';

        if (clientPackage === 'Start') {
          lockedText.textContent = `Google Ads platforma nije uključena u klijentov Start paket suradnje. Nadogradite klijentov paket na Pro ili Ultra kako biste otključali pretraživačko oglašavanje, pacing proračuna i financijsku analitiku.`;
          panelLocked.classList.remove('hidden');
          setTimeout(() => {
            panelLocked.classList.remove('opacity-0', 'scale-95');
            panelLocked.classList.add('opacity-100', 'scale-100');
          }, 50);
        } else {
          panelGoogle.classList.remove('hidden');
