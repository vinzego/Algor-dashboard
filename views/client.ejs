                      className="px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-xs font-bold text-gray-500"
                    >
                      Odustani
                    </button>
                    <button 
                      type="submit"
                      className="px-6 py-2.5 rounded-xl bg-zorange text-white text-xs font-black uppercase tracking-wider hover:bg-zorangehover transition-colors shadow-md"
                    >
                      Spremi Klijenta & Pokreni AI Analysis
                    </button>
                  </div>
                </form>

              </div>
            </div>
          )}

        </div>
      );
    }

    // Render React App
    const root = ReactDOM.createRoot(document.getElementById('react-root'));
    root.render(<DashboardApp />);
  </script>
</body>
</html>
