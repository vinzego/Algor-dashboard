                      </div>
                      <div>
                        <label className="text-[11px] font-bold text-gray-500 block mb-1">Ciljani ROAS (x)</label>
                        <input 
                          type="number" step="0.1" 
                          value={newClientForm.targetROAS} 
                          onChange={(e) => setNewClientForm({...newClientForm, targetROAS: e.target.value})}
                          placeholder="4.0" 
                          className="w-full px-3 py-2 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-xs font-bold focus:outline-none focus:border-zorange"
                        />
                      </div>
                    </div>
                  </div>

                  {/* GROUP 3: INTEGRATIONS & TECHNICAL IDS */}
                  <div className="space-y-3 pt-3 border-t border-gray-100 dark:border-gray-800">
                    <h4 className="text-xs font-black uppercase text-blue-600 dark:text-blue-400 tracking-wider flex items-center gap-1.5">
                      <i className="fa-solid fa-plug"></i> 3. Integracije i Tehnički ID-ovi
                    </h4>
                    <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                      <div>
                        <label className="text-[11px] font-bold text-gray-500 block mb-1">Meta Business ID</label>
                        <input 
                          type="text" 
                          value={newClientForm.metaBusinessId} 
                          onChange={(e) => setNewClientForm({...newClientForm, metaBusinessId: e.target.value})}
                          placeholder="MB-984120" 
                          className="w-full px-3 py-2 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-xs font-bold focus:outline-none focus:border-zorange"
                        />
                      </div>
                      <div>
                        <label className="text-[11px] font-bold text-gray-500 block mb-1">Meta Ad Account ID</label>
                        <input 
                          type="text" 
                          value={newClientForm.metaAdAccountId} 
                          onChange={(e) => setNewClientForm({...newClientForm, metaAdAccountId: e.target.value})}
                          placeholder="act_1048201" 
                          className="w-full px-3 py-2 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-xs font-bold focus:outline-none focus:border-zorange"
                        />
                      </div>
                      <div>
                        <label className="text-[11px] font-bold text-gray-500 block mb-1">Google Ads ID</label>
                        <input 
                          type="text" 
                          value={newClientForm.googleAdsId} 
                          onChange={(e) => setNewClientForm({...newClientForm, googleAdsId: e.target.value})}
                          placeholder="492-108-9410" 
                          className="w-full px-3 py-2 rounded-xl bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-xs font-bold focus:outline-none focus:border-zorange"
                        />
                      </div>
                    </div>
                  </div>

                  {/* Actions */}
                  <div className="flex justify-end gap-3 pt-4 border-t border-gray-100 dark:border-gray-800">
                    <button 
                      type="button" 
                      onClick={() => setIsAddModalOpen(false)}
                      className="px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-gray-800 text-xs font-bold text-gray-500"
                    >
                      Odustani
                    </button>
                    <button 
                      type="submit"
                      className="px-6 py-2.5 rounded-xl bg-zorange text-white text-xs font-black uppercase tracking-wider hover:bg-zorangehover transition-colors shadow-md"
                    >
                      Spremi Klijenta & Pokreni AI Analysis
                    </button>
                  </div>

                </form>

              </div>
            </div>
          )}

        </div>
      );
    }

    // Render React App
    const root = ReactDOM.createRoot(document.getElementById('react-root'));
    root.render(<DashboardApp />);
  </script>
</body>
</html>
