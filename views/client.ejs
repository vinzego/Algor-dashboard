<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= client ? client.name : 'Agency Portfolio' %> - ZELLIFY Marketing Dashboard</title>

  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            zdark: '#111113',
            zgray: '#F4F5F7',
            zorange: '#FF5F00',
            zorangehover: '#E05300',
            zmuted: '#6B7280'
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Apache ECharts CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>

  <!-- React 18 & ReactDOM UMD CDNs -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <!-- Babel Standalone for JSX compilation -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-[#F4F5F7] dark:bg-[#0B0B0C] min-h-screen text-[#111113] dark:text-gray-100 transition-colors duration-200 antialiased overflow-x-hidden">
  
  <!-- React Mount Point -->
  <div id="react-root"></div>

  <!-- Client-side React Dashboard Application -->
  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    // --- ACCOUNTS DATA FROM EXPRESS BACKEND ---
    const INITIAL_CLIENTS = <%- JSON.stringify(clients) %>;
    const SERVER_CLIENT_ID = <%= client ? `'${client.id}'` : 'null' %>;

    const DATE_RANGES = [
      { id: '7d', label: 'Zadnjih 7 dana (Last 7 Days)' },
      { id: '30d', label: 'Zadnjih 30 dana (Last 30 Days)' },
      { id: 'this_month', label: 'Ovaj Mjesec (This Month)' }
    ];

    const getDays = (count = 12) => Array.from({ length: count }, (_, i) => `${i + 1}.08.`);

    // --- REUSABLE ECHARTS REACT COMPONENT WITH RESIZEOBSERVER ---
    const EChartComponent = ({ option, style = { width: '100%', height: '280px' } }) => {
      const chartRef = useRef(null);
      const instanceRef = useRef(null);

      useEffect(() => {
        if (!chartRef.current) return;
        if (!instanceRef.current) {
          instanceRef.current = echarts.init(chartRef.current);
        }
        instanceRef.current.setOption(option, true);

        const resizeChart = () => {
          if (instanceRef.current) instanceRef.current.resize();
        };

        const observer = new ResizeObserver(() => resizeChart());
        observer.observe(chartRef.current);

        window.addEventListener('resize', resizeChart);
        return () => {
          observer.disconnect();
          window.removeEventListener('resize', resizeChart);
        };
      }, [option]);

      return <div ref={chartRef} style={style} className="w-full min-w-0 max-w-full" />;
    };

    // --- SKELETON LOADER COMPONENT ---
    const SkeletonCard = () => (
      <div className="z-card-white dark:bg-[#161618] rounded-[2rem] p-6 animate-pulse flex flex-col justify-between h-[270px]">
        <div className="flex justify-between items-center">
          <div className="w-24 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
          <div className="w-12 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
        </div>
        <div className="w-full h-24 bg-gray-100 dark:bg-gray-800 rounded-2xl my-2"></div>
        <div className="w-32 h-6 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
      </div>
    );

    // --- MAIN REACT DASHBOARD APPLICATION ---
    function DashboardApp() {
      const [clientsList, setClientsList] = useState(INITIAL_CLIENTS);
      const [selectedAccount, setSelectedAccount] = useState(SERVER_CLIENT_ID || 'acme-corp');
      const [isHomeView, setIsHomeView] = useState(SERVER_CLIENT_ID === null);
      
      const [clientTab, setClientTab] = useState('organic'); // 'organic' | 'meta-ads' | 'google-ads'
      const [dateRange, setDateRange] = useState('30d');
      const [isLoading, setIsLoading] = useState(false);
      const [darkMode, setDarkMode] = useState(false);

      // AI Sidebar State
      const [isAiOpen, setIsAiOpen] = useState(false);
      const [aiMessages, setAiMessages] = useState([
        { 
          id: 1, 
          sender: 'ai', 
          content: 'Pozdrav Vinko! Ja sam tvoj Marketing Co-Pilot. Spreman sam za analizu učinkovitosti i optimizaciju oglasa.',
          thoughts: ['Učitavam bazu podataka i aktivne metrike...'],
          actions: [
            { label: '🔍 Analiziraj trenutni prikaz', prompt: 'Napravi brzu dijagnostiku trenutnog prikaza' },
            { label: '💡 Predloži ad copy varijante', prompt: 'Predloži 3 nova naslova za oglas s visokim CTR-om' }
          ]
        }
      ]);
      const [aiInputText, setAiInputText] = useState('');
      const [isAiTyping, setIsAiTyping] = useState(false);

      // Modal & Banner state
      const [isAddModalOpen, setIsAddModalOpen] = useState(false);
      const [bannerDismissed, setBannerDismissed] = useState(false);

      // Form state for Add Client Modal
      const [newClientForm, setNewClientForm] = useState({
        name: '',
        industry: '',
        targetAudience: '',
        primaryGoal: 'Lead Generation',
        targetBudget: '5000',
        targetCPA: '15.00',
        targetROAS: '4.0',
        metaBusinessId: '',
        metaAdAccountId: '',
        googleAdsId: '',
        fbPageId: '',
        igProfileId: ''
      });

      // Table Sorting states
      const [postSortKey, setPostSortKey] = useState('reach');
      const [postSortDir, setPostSortDir] = useState('desc');

      const [adSortKey, setAdSortKey] = useState('spend');
      const [adSortDir, setAdSortDir] = useState('desc');

      const [searchTermSortKey, setSearchTermSortKey] = useState('clicks');
      const [searchTermSortDir, setSearchTermSortDir] = useState('desc');

      // Negative Keywords list
      const [negativeKeywords, setNegativeKeywords] = useState(['besplatno', 'torrent', 'rabljeno']);

      // Toggle Dark Mode
      useEffect(() => {
        if (darkMode) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }, [darkMode]);

      const currentClientObj = useMemo(() => {
        return clientsList.find(c => c.id === selectedAccount) || clientsList[0];
      }, [clientsList, selectedAccount]);

      // Handle Client Change
      const handleAccountChange = (e) => {
        const id = e.target.value;
        if (id === 'HOME') {
          setIsHomeView(true);
          return;
        }
        setIsLoading(true);
        setSelectedAccount(id);
        setIsHomeView(false);
        setTimeout(() => setIsLoading(false), 300);
      };

      const handleDateChange = (e) => {
        setIsLoading(true);
        setDateRange(e.target.value);
        setTimeout(() => setIsLoading(false), 300);
      };

      // Open Client Dashboard from Home Card
      const openClientDashboard = (clientId) => {
        setSelectedAccount(clientId);
        setIsHomeView(false);
      };

      // --- ADD NEW CLIENT HANDLER ---
      const handleAddClientSubmit = async (e) => {
        e.preventDefault();
        if (!newClientForm.name) return;

        try {
          const res = await fetch('/api/client/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(newClientForm)
          });
          const data = await res.json();
          if (data.success && data.client) {
            setClientsList(prev => [...prev, data.client]);
            setSelectedAccount(data.client.id);
            setIsHomeView(false);
            setIsAddModalOpen(false);
          }
        } catch (err) {
          console.error(err);
          // Local fallback
          const slugId = newClientForm.name.toLowerCase().replace(/\s+/g, '-');
          const mockCreated = {
            id: slugId,
            name: newClientForm.name,
            logo: newClientForm.name.slice(0, 2).toUpperCase(),
            package: 'Enterprise',
            industry: newClientForm.industry || 'E-commerce',
            status: 'Healthy',
            stats: { reach: '10.5k', impressions: '45.2k', ctr: '3.1%', spend: `$${newClientForm.targetBudget}` },
            metaStats: { totalSpend: `$${newClientForm.targetBudget}`, cpa: `$${newClientForm.targetCPA}`, cpaTrend: { value: '5%', direction: 'down' }, resultsValue: '180 Leads' }
          };
          setClientsList(prev => [...prev, mockCreated]);
          setSelectedAccount(slugId);
          setIsHomeView(false);
          setIsAddModalOpen(false);
        }
      };

      // --- AI ASSISTANT CHAT SEND HANDLER ---
      const handleSendAiMessage = async (customPrompt) => {
        const textToSend = customPrompt || aiInputText;
        if (!textToSend.trim()) return;

        const userMsg = { id: Date.now(), sender: 'user', content: textToSend };
        setAiMessages(prev => [...prev, userMsg]);
        if (!customPrompt) setAiInputText('');
        setIsAiTyping(true);

        // Add temporary AI streaming message
        const aiMsgId = Date.now() + 1;
        setAiMessages(prev => [
          ...prev, 
          { 
            id: aiMsgId, 
            sender: 'ai', 
            content: '', 
            thoughts: [`Dohvaćam aktivne podatke za ${currentClientObj ? currentClientObj.name : 'Portfolio'}...`, `Analiziram metrike (${clientTab.toUpperCase()}, ${dateRange})...`] 
          }
        ]);

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: textToSend,
              clientId: selectedAccount
            })
          });

          const reader = response.body.getReader();
          const decoder = new TextDecoder('utf-8');
          let accumulatedContent = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunkStr = decoder.decode(value);
            const lines = chunkStr.split('\n\n');

            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const dataStr = line.replace('data: ', '').trim();
                if (dataStr === '[DONE]') continue;
                try {
                  const parsed = JSON.parse(dataStr);
                  if (parsed.type === 'FINAL_RESPONSE') {
                    accumulatedContent += parsed.content;
                    setAiMessages(prev => prev.map(m => m.id === aiMsgId ? { ...m, content: accumulatedContent } : m));
                  }
                } catch (e) {}
              }
            }
          }
        } catch (err) {
          setAiMessages(prev => prev.map(m => m.id === aiMsgId ? {
            ...m,
            content: `**AI Analiza za ${currentClientObj.name}:**\n\nMetrike za **${clientTab.toUpperCase()}** pokazuju stabilne performanse uz ciljani CPA od **${currentClientObj.financialTargets ? currentClientObj.financialTargets.targetCPA : '$15.00'}**.\n\nPreporučujem povećanje budžeta za 15% na najjačim kreativi.`
          } : m));
        } finally {
          setIsAiTyping(false);
        }
      };

      // Action triggers from inline AI buttons
      const triggerAiIntervention = (promptText) => {
        setIsAiOpen(true);
        handleSendAiMessage(promptText);
      };

      const addNegativeKeyword = (kw) => {
        if (!negativeKeywords.includes(kw)) {
          setNegativeKeywords(prev => [...prev, kw]);
        }
        triggerAiIntervention(`Dodan negativni ključni izraz: "${kw}". Potvrdi optimizaciju kampanje.`);
      };

      // --- MOCK DATASETS & ECHARTS OPTIONS ---
      const mult = dateRange === '7d' ? 0.35 : dateRange === 'this_month' ? 0.85 : 1.0;

      // TAB 1: Organic Data
      const organicData = useMemo(() => ({
        reach: Math.round(128450 * mult).toLocaleString(),
        err: '6.4%',
        netFollowers: `+${Math.round(1380 * mult)}`,
        websiteTaps: Math.round(3890 * mult).toLocaleString(),
        reachTrendOption: {
          tooltip: { trigger: 'axis' },
          legend: { data: ['Total Reach', 'Total Impressions'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
          grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
          xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: [
            { name: 'Total Reach', type: 'line', data: [8200, 9400, 11200, 10800, 12500, 14100, 13800, 15200, 16800, 15900, 17400, 18600].map(v => Math.round(v * mult)), smooth: true, lineStyle: { width: 3, color: '#FF5F00' }, areaStyle: { color: 'rgba(255, 95, 0, 0.15)' }, itemStyle: { color: '#FF5F00' } },
            { name: 'Total Impressions', type: 'line', data: [24000, 27500, 31000, 29800, 34200, 38900, 37500, 41200, 44800, 42900, 46100, 49500].map(v => Math.round(v * mult)), smooth: true, lineStyle: { width: 3, color: darkMode ? '#E4E4E7' : '#111113' }, itemStyle: { color: darkMode ? '#E4E4E7' : '#111113' } }
          ]
        },
        engagementOption: {
          tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
          legend: { data: ['Saves (Core Signal)', 'Shares (Core Signal)', 'Likes', 'Comments'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
          grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
          xAxis: { type: 'category', data: ['Post #1', 'Post #2', 'Post #3', 'Post #4', 'Post #5', 'Post #6'], axisLabel: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 10 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: [
            { name: 'Saves (Core Signal)', type: 'bar', stack: 'total', data: [340, 520, 410, 680, 590, 810], itemStyle: { color: '#FF5F00' } },
            { name: 'Shares (Core Signal)', type: 'bar', stack: 'total', data: [210, 380, 290, 450, 390, 560], itemStyle: { color: darkMode ? '#E4E4E7' : '#111113' } },
            { name: 'Likes', type: 'bar', stack: 'total', data: [1200, 1850, 1420, 2100, 1950, 2600], itemStyle: { color: '#E1306C' } },
            { name: 'Comments', type: 'bar', stack: 'total', data: [180, 290, 210, 340, 280, 410], itemStyle: { color: '#1877F2', borderRadius: [4, 4, 0, 0] } }
          ]
        },
        posts: [
          { id: 1, thumb: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=120&fit=crop', caption: 'Ljetni popust 20% na sve usluge! 🚀', type: 'Reel', reach: 42100, err: '7.8%', saves: 890, shares: 640 },
          { id: 2, thumb: 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=120&fit=crop', caption: 'Vodič kroz marketing strategiju 📊', type: 'Carousel', reach: 31400, err: '6.5%', saves: 1120, shares: 480 },
          { id: 3, thumb: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=120&fit=crop', caption: 'Kako doći do više konverzija uz Meta Ads? 💡', type: 'Reel', reach: 28900, err: '5.9%', saves: 740, shares: 390 }
        ]
      }), [mult, darkMode]);

      // TAB 2: Meta Ads Data
      const metaAdsData = useMemo(() => ({
        spend: `$${(4850.00 * mult).toLocaleString('en-US', { minimumFractionDigits: 2 })}`,
        roas: '4.25x',
        cpa: `$${(14.20).toFixed(2)}`,
        conversions: `${Math.round(341 * mult)} Leads`,
        efficiencyOption: {
          tooltip: { trigger: 'axis' },
          legend: { data: ['Daily Spend ($)', 'Blended ROAS (x)'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
          grid: { top: 30, bottom: 40, left: 15, right: 15, containLabel: true },
          xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: [
            { type: 'value', name: 'Spend ($)', axisLabel: { color: '#6B7280', fontSize: 10, formatter: '${value}' } },
            { type: 'value', name: 'ROAS (x)', min: 0, max: 6, axisLabel: { color: '#FF5F00', fontSize: 10, formatter: '{value}x' } }
          ],
          series: [
            { name: 'Daily Spend ($)', type: 'bar', barWidth: '35%', data: [210, 240, 280, 310, 290, 340, 420, 390, 450, 480, 460, 520].map(v => Math.round(v * mult)), itemStyle: { color: darkMode ? '#3F3F46' : '#111113', borderRadius: [4, 4, 0, 0] } },
            { name: 'Blended ROAS (x)', type: 'line', yAxisIndex: 1, data: [4.8, 4.6, 4.3, 3.9, 4.2, 4.5, 3.8, 4.1, 4.4, 4.2, 4.5, 4.3], smooth: true, lineStyle: { width: 3, color: '#FF5F00' }, itemStyle: { color: '#FF5F00' } }
          ]
        },
        fatigueOption: {
          tooltip: { trigger: 'axis' },
          legend: { data: ['Ad Frequency', 'CTR Link (%)'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
          grid: { top: 30, bottom: 40, left: 15, right: 15, containLabel: true },
          xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: [
            { type: 'value', name: 'Frequency', min: 1, max: 5, axisLabel: { color: '#EF4444', fontSize: 10, formatter: '{value}x' } },
            { type: 'value', name: 'CTR (%)', min: 0, max: 5, axisLabel: { color: '#059669', fontSize: 10, formatter: '{value}%' } }
          ],
          series: [
            { name: 'Ad Frequency', type: 'line', data: [1.4, 1.7, 2.1, 2.4, 2.8, 3.1, 3.4, 3.7, 4.0, 4.2, 4.5, 4.8], smooth: true, lineStyle: { width: 3, color: '#EF4444' }, itemStyle: { color: '#EF4444' } },
            { name: 'CTR Link (%)', type: 'line', yAxisIndex: 1, data: [3.8, 3.6, 3.4, 3.1, 2.8, 2.4, 2.1, 1.8, 1.5, 1.3, 1.1, 0.9], smooth: true, lineStyle: { width: 3, color: '#059669' }, itemStyle: { color: '#059669' } }
          ]
        },
        funnelOption: {
          tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
          legend: { data: ['Outbound Link Clicks', 'Verified Landing Page Views'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
          grid: { top: 20, bottom: 45, left: 15, right: 15, containLabel: true },
          xAxis: { type: 'category', data: ['Tjedan 1', 'Tjedan 2', 'Tjedan 3', 'Tjedan 4'], axisLabel: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: [
            { name: 'Outbound Link Clicks', type: 'bar', barWidth: '35%', data: [1240, 1480, 1620, 1850].map(v => Math.round(v * mult)), itemStyle: { color: '#1877F2', borderRadius: [4, 4, 0, 0] } },
            { name: 'Verified Landing Page Views', type: 'bar', barWidth: '35%', data: [940, 1120, 1210, 1380].map(v => Math.round(v * mult)), itemStyle: { color: '#FF5F00', borderRadius: [4, 4, 0, 0] } }
          ]
        },
        ads: [
          { id: 1, name: 'Ljetni Popust 20% Video', placement: 'IG Reels', spend: 1420.00, ctr: 3.42, cpa: 12.40, hookRate: 44.2, status: 'Active' },
          { id: 2, name: 'Retargeting Napuštene Košarice', placement: 'FB Feed', spend: 1180.00, ctr: 2.85, cpa: 14.10, hookRate: 38.5, status: 'Active' },
          { id: 3, name: 'Lookalike 1% KUPCI Karusel', placement: 'IG Feed', spend: 950.00, ctr: 2.41, cpa: 16.80, hookRate: 31.0, status: 'Active' },
          { id: 4, name: 'Ad 4: Klijent Review Video', placement: 'IG Stories', spend: 460.00, ctr: 0.90, cpa: 22.40, hookRate: 28.4, status: 'Active' }
        ]
      }), [mult, darkMode]);

      // TAB 3: Google Ads Data
      const googleAdsData = useMemo(() => ({
        spend: `$${(550.00 * mult).toFixed(2)}`,
        convValue: `$${(2640.00 * mult).toFixed(2)}`,
        cpa: `$${(18.33).toFixed(2)}`,
        impressionShare: '72%',
        trafficCostOption: {
          tooltip: { trigger: 'axis' },
          legend: { data: ['Clicks', 'Avg. CPC ($)'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
          grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
          xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: [
            { type: 'value', name: 'Clicks', axisLabel: { color: '#6B7280', fontSize: 10 } },
            { type: 'value', name: 'CPC ($)', min: 0, max: 2, axisLabel: { color: '#FF5F00', fontSize: 10, formatter: '${value}' } }
          ],
          series: [
            { name: 'Clicks', type: 'line', data: [42, 48, 55, 61, 58, 64, 72, 69, 78, 82, 79, 88].map(v => Math.round(v * mult)), smooth: true, lineStyle: { width: 3, color: '#4285F4' }, itemStyle: { color: '#4285F4' } },
            { name: 'Avg. CPC ($)', type: 'line', yAxisIndex: 1, data: [0.92, 0.88, 0.85, 0.82, 0.84, 0.79, 0.76, 0.78, 0.75, 0.73, 0.74, 0.71], smooth: true, lineStyle: { width: 3, color: '#FF5F00' }, itemStyle: { color: '#FF5F00' } }
          ]
        },
        campaignBreakdownOption: {
          tooltip: { trigger: 'item', formatter: '{b}: ${c} ({d}%)' },
          legend: { bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
          series: [{
            name: 'Potrošnja po Tipu Kampanje',
            type: 'pie',
            radius: ['45%', '70%'],
            avoidLabelOverlap: false,
            itemStyle: { borderRadius: 10, borderColor: darkMode ? '#161618' : '#ffffff', borderWidth: 2 },
            data: [
              { value: Math.round(302.50 * mult), name: 'Google Search', itemStyle: { color: '#4285F4' } },
              { value: Math.round(176.00 * mult), name: 'Performance Max (PMax)', itemStyle: { color: '#34A853' } },
              { value: Math.round(71.50 * mult), name: 'Display & Remarketing', itemStyle: { color: '#FBBC05' } }
            ]
          }]
        },
        searchTerms: [
          { keyword: 'digitalna agencija zagreb', clicks: 142, conversions: 18, cost: 124.50, suggestedNegative: null },
          { keyword: 'izrada web stranica cijena', clicks: 98, conversions: 12, cost: 89.20, suggestedNegative: null },
          { keyword: 'besplatni marketing tečajovi', clicks: 64, conversions: 0, cost: 48.00, suggestedNegative: 'besplatni' },
          { keyword: 'najbolje marketing agencije hr', clicks: 52, conversions: 6, cost: 42.10, suggestedNegative: null },
          { keyword: 'torrent marketing knjige pdf', clicks: 38, conversions: 0, cost: 32.50, suggestedNegative: 'torrent' }
        ]
      }), [mult, darkMode]);

      return (
        <div className="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 py-5 transition-all duration-300">
          
          {/* ========================================================================= */}
          {/* 1. GLOBAL TOP NAVIGATION BAR */}
