<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= client.name %> - ZELLIFY Marketing Dashboard</title>
  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zdark: '#111113',
            zgray: '#F4F5F7',
            zorange: '#FF5F00',
            zorangehover: '#E05300',
            zmuted: '#6B7280'
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Apache ECharts CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>
</head>
<body class="bg-[#F4F5F7] min-h-screen relative pb-16 text-[#111113]">

  <!-- Full-Width Container (100% width, matching ZELLIFY iPad layout) -->
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-8 lg:px-10 py-6">
    
    <!-- TOP NAVBAR HEADER (ZELLIFY Style Capsule Header) -->
    <header class="mb-8">
      <nav class="bg-white rounded-full px-6 py-3.5 flex items-center justify-between shadow-sm border border-black/5">
        
        <!-- Left: Logo & Back Link -->
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 border border-black/5 text-[#111113] hover:bg-black hover:text-white transition-all duration-200">
            <i class="fa-solid fa-arrow-left text-xs"></i>
          </a>
          
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-zorange flex items-center justify-center text-white font-black text-sm shadow-sm">
              <i class="fa-solid fa-bolt-lightning"></i>
            </div>
            <span class="text-xl font-black tracking-tight text-[#111113]">ZELLIFY<span class="text-zorange">.</span></span>
          </div>
        </div>
        
        <!-- Center: Capsule Pill Switcher Navigation (5 Unlocked Views) -->
        <div class="z-pill-nav flex items-center gap-1">
          <button id="btn-360" class="z-pill-nav-item-active px-5 py-2 text-xs transition-all duration-200" onclick="switchPlatform('360')">
            Dashboard
          </button>

          <button id="btn-meta" class="z-pill-nav-item px-4 py-2 text-xs transition-all duration-200" onclick="switchPlatform('meta')">
            Meta Ads
          </button>
          
          <button id="btn-google" class="z-pill-nav-item px-4 py-2 text-xs transition-all duration-200" onclick="switchPlatform('google')">
            Google Ads (PMax)
          </button>
          
          <button id="btn-tiktok" class="z-pill-nav-item px-4 py-2 text-xs transition-all duration-200" onclick="switchPlatform('tiktok')">
            TikTok Ads
          </button>

          <button id="btn-social" class="z-pill-nav-item px-4 py-2 text-xs transition-all duration-200" onclick="switchPlatform('social')">
            Objave & Sadržaj
          </button>
        </div>
        
        <!-- Right Controls: Theme Toggles + Date Filter + Avatar -->
        <div class="flex items-center gap-3">
          <!-- Light/Dark Mode Switcher Icons -->
          <div class="hidden sm:flex items-center gap-1 bg-gray-100 border border-black/5 p-1 rounded-full text-xs font-bold text-gray-600">
            <button class="w-7 h-7 rounded-full bg-zorange text-white flex items-center justify-center shadow-xs"><i class="fa-solid fa-sun text-xs"></i></button>
            <button class="w-7 h-7 rounded-full hover:bg-gray-200 flex items-center justify-center"><i class="fa-solid fa-moon text-xs"></i></button>
          </div>

          <!-- Date Filter Pill Button -->
          <button class="z-badge-black px-4 py-2 text-xs flex items-center gap-2 hover:bg-gray-800 transition-colors shadow-xs">
            <i class="fa-solid fa-chart-line text-xs opacity-75"></i>
            <span>Zadnjih 30 dana</span>
            <i class="fa-solid fa-chevron-down text-[10px] opacity-75"></i>
          </button>

          <!-- Notification Bell Icon (Obavijesti & Upozorenja) -->
          <div class="relative">
            <button id="btn-notifications" onclick="toggleNotifications()" class="relative w-9 h-9 rounded-full bg-gray-100 hover:bg-black hover:text-white border border-black/5 flex items-center justify-center text-[#111113] transition-all duration-200 shadow-xs" title="Marketinške obavijesti i preporuke">
              <i class="fa-solid fa-bell text-xs"></i>
              <!-- Red Alert Badge Count -->
              <span class="absolute -top-1 -right-1 w-4 h-4 bg-zorange text-white text-[9px] font-black rounded-full flex items-center justify-center border border-white shadow-xs">
                <%= client.executiveHealthCheck.criticalIssues.length + client.executiveHealthCheck.actionFixes.length %>
              </span>
            </button>

            <!-- Notification Dropdown Popover -->
            <div id="dropdown-notifications" class="hidden absolute right-0 mt-3 w-80 md:w-96 bg-white rounded-[2rem] shadow-2xl border border-black/10 p-5 z-50 transition-all duration-200 text-[#111113]">
              <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-3">
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-xl bg-zorange text-white flex items-center justify-center font-black text-xs shadow-xs">
                    <i class="fa-solid fa-bell"></i>
                  </div>
                  <h4 class="text-xs font-black uppercase tracking-wider text-[#111113]">Upozorenja & Preporučeni Popravci</h4>
                </div>
                <span class="z-badge-green text-[10px] px-2.5 py-0.5"><%= client.executiveHealthCheck.overallHealth %></span>
              </div>

              <!-- Scrollable Alert Items List -->
              <div class="space-y-3 max-h-80 overflow-y-auto pr-1">
                <!-- Critical Issues (Što ne valja / Potrebno popraviti) -->
                <div class="space-y-2">
                  <p class="text-[10px] font-black uppercase tracking-wider text-rose-600 flex items-center gap-1">
                    <i class="fa-solid fa-triangle-exclamation"></i> Potrebno popraviti u marketingu (<%= client.executiveHealthCheck.criticalIssues.length %>)
                  </p>
                  <% client.executiveHealthCheck.criticalIssues.forEach(item => { %>
                    <div class="bg-rose-50 border border-rose-100 rounded-xl p-3 text-xs font-bold text-rose-950">
                      <strong class="block text-rose-900 mb-0.5"><%= item.title %></strong>
                      <p class="text-[11px] font-semibold text-rose-800 leading-tight"><%= item.desc %></p>
                    </div>
                  <% }); %>
                </div>

                <!-- Action Fixes (Preporučene radnje) -->
                <div class="space-y-2 pt-2 border-t border-gray-100">
                  <p class="text-[10px] font-black uppercase tracking-wider text-zorange flex items-center gap-1">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Preporučeni brzi popravci (<%= client.executiveHealthCheck.actionFixes.length %>)
                  </p>
                  <% client.executiveHealthCheck.actionFixes.forEach(item => { %>
                    <div class="bg-orange-50 border border-orange-100 rounded-xl p-3 text-xs font-bold text-orange-950">
                      <strong class="block text-orange-950 mb-0.5"><%= item.title %></strong>
                      <p class="text-[11px] font-semibold text-gray-600 leading-tight">Utjecaj: <%= item.impact %></p>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>

          <!-- User Profile Avatar -->
          <div class="relative w-9 h-9 rounded-full bg-gray-200 border-2 border-white shadow-xs overflow-hidden">
            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" alt="Avatar" class="w-full h-full object-cover" />
          </div>
        </div>
      </nav>
    </header>

    <!-- SUBHEADER TITLE & CLIENT INFO ROW -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-gray-500 flex items-center gap-1.5">
          <span>Dobrodošao natrag, Vinko 👋</span>
          <span class="w-1.5 h-1.5 rounded-full bg-zorange inline-block"></span>
          <span class="text-[#111113] font-black"><%= client.name %></span>
        </p>
        <h1 class="text-3xl md:text-4xl font-black text-[#111113] tracking-tight mt-1">Nadzorna Ploča i Analitika</h1>
      </div>

      <div class="flex items-center gap-3">
        <!-- Client Package Badge -->
        <span class="px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-white border border-black/10 text-[#111113] shadow-xs">
          Paket: <%= client.package %> (Nivo Usluge)
        </span>
        <!-- Monthly Posts Badge -->
        <span class="px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-wider bg-zorange text-white shadow-xs flex items-center gap-1.5">
          <i class="fa-solid fa-calendar-check text-xs"></i> Objavljeno <%= client.publishedPosts %> / <%= client.maxPosts %> postova
        </span>
      </div>
    </div>

    <!-- MAIN DASHBOARD CONTENT AREA (100% Full Width - AI Sidebar Removed) -->
    <main class="w-full">

      <!-- SECTION 1: 360° OVERVIEW (ZELLIFY UI CARDS MATCHING REFERENCE IMAGE) -->
      <section id="panel-advanced-analytics" class="transition-all duration-300 opacity-100 scale-100">
        
        <!-- ZELLIFY TOP WIDGETS ROW (MATCHING REFERENCE IMAGE CARDS 1 - 4) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          
          <!-- CARD 1: DARK HERO CARD (Like MFR Gauge Card in Image) -->
          <div class="z-card-dark rounded-[2rem] p-6 flex flex-col justify-between h-[270px] relative overflow-hidden shadow-xl">
            <div class="flex justify-between items-center z-10">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-white text-xs">
                  <i class="fa-solid fa-gauge-high"></i>
                </div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-white/90">MFR / Blended MER</span>
              </div>
              <span class="z-badge-orange text-[10px] px-2.5 py-1 uppercase shadow-xs">+4% Increased</span>
            </div>

            <!-- Middle Half-Donut Gauge Meter -->
            <div class="relative w-full h-[120px] flex items-center justify-center my-1 z-10">
              <div id="z-chart-mfr-gauge" class="w-full h-full"></div>
              <div class="absolute bottom-2 text-center">
                <span class="text-xs font-bold text-white/70 block">Target 3.5x</span>
                <span class="text-base font-black text-zorange"><%= client.advancedAnalytics.blended.blendedMer %></span>
              </div>
            </div>

            <div class="z-10">
              <span class="text-[10px] uppercase font-bold text-white/60 block">Zbirni Ulazni Proračun</span>
              <h3 class="text-3xl font-black text-white tracking-tight"><%= client.advancedAnalytics.blended.totalSpend %></h3>
            </div>
          </div>

          <!-- CARD 2: WHITE LINE SPARKLINE CARD (Ukupan broj pratitelja na IG i FB) -->
          <div class="z-card-white z-card-white-hover rounded-[2rem] p-6 flex flex-col justify-between h-[270px]">
            <div class="flex justify-between items-start">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-zorange text-xs">
                  <i class="fa-solid fa-users"></i>
                </div>
                <div>
                  <span class="text-xs font-extrabold uppercase tracking-wider text-gray-500 block">Ukupno Pratitelja</span>
                  <span class="text-[10px] text-gray-400 font-bold flex items-center gap-1">
                    <i class="fa-brands fa-instagram text-pink-600"></i> IG + <i class="fa-brands fa-facebook-f text-blue-600"></i> FB
                  </span>
                </div>
              </div>
              <span class="z-badge-orange text-[10px] px-2.5 py-0.5 text-white shadow-xs">+5.8%</span>
            </div>

            <!-- ECharts Sparkline Trend -->
            <div id="z-chart-revenue-sparkline" class="w-full h-[95px]"></div>

            <div class="flex items-center justify-between border-t border-gray-100 pt-2.5">
              <div>
                <h3 class="text-3xl font-black text-[#111113] tracking-tight">24,850</h3>
                <p class="text-[10px] text-gray-400 font-bold">Rast u tekućem mjesecu</p>
              </div>
              <div class="text-right text-[10px] font-bold space-y-0.5">
                <p class="text-pink-600 flex items-center justify-end gap-1"><i class="fa-brands fa-instagram"></i> 16,200</p>
                <p class="text-blue-600 flex items-center justify-end gap-1"><i class="fa-brands fa-facebook-f"></i> 8,650</p>
              </div>
            </div>
          </div>

          <!-- CARD 3: NEW USERS / TOP CONTENT LIST CARD (Like New Users Card in Image) -->
          <div class="z-card-white z-card-white-hover rounded-[2rem] p-6 flex flex-col justify-between h-[270px]">
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-[#111113] text-xs">
                  <i class="fa-solid fa-users"></i>
                </div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-gray-500">Top Aktivni Postovi</span>
              </div>
              <button class="text-gray-400 hover:text-black transition-colors"><i class="fa-solid fa-ellipsis"></i></button>
            </div>

            <!-- List of Users/Posts -->
            <div class="space-y-2.5 my-2">
              <div class="flex items-center justify-between text-xs font-bold">
                <div class="flex items-center gap-2.5">
                  <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&fit=crop" class="w-7 h-7 rounded-full object-cover" />
                  <div>
                    <p class="text-[#111113] font-black leading-tight">Nagradni Natječaj</p>
                    <p class="text-[10px] text-emerald-600 font-semibold flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online (42.1k)</p>
                  </div>
                </div>
                <button class="text-gray-400 hover:text-black"><i class="fa-solid fa-ellipsis"></i></button>
              </div>

              <div class="flex items-center justify-between text-xs font-bold">
                <div class="flex items-center gap-2.5">
                  <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=100&fit=crop" class="w-7 h-7 rounded-full object-cover" />
                  <div>
                    <p class="text-[#111113] font-black leading-tight">Ljetni Popust 20%</p>
                    <p class="text-[10px] text-emerald-600 font-semibold flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online (31.4k)</p>
                  </div>
                </div>
                <button class="text-gray-400 hover:text-black"><i class="fa-solid fa-ellipsis"></i></button>
              </div>

              <div class="flex items-center justify-between text-xs font-bold">
                <div class="flex items-center gap-2.5">
                  <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=100&fit=crop" class="w-7 h-7 rounded-full object-cover" />
                  <div>
                    <p class="text-[#111113] font-black leading-tight">Digital Marketing Vodič</p>
                    <p class="text-[10px] text-gray-500 font-semibold">Prije 10 minuta</p>
                  </div>
                </div>
                <button class="text-gray-400 hover:text-black"><i class="fa-solid fa-ellipsis"></i></button>
              </div>
            </div>

            <!-- Capsule Search Input -->
            <div class="bg-gray-100 rounded-full px-3.5 py-1.5 flex items-center gap-2">
              <i class="fa-solid fa-magnifying-glass text-xs text-gray-400"></i>
              <input type="text" placeholder="Pretraži objave..." class="bg-transparent text-xs font-medium text-[#111113] placeholder-gray-400 focus:outline-none w-full" />
            </div>
          </div>

          <!-- CARD 4: SUBSCRIBERS / CONVERSIONS BAR CHART CARD (Like Subscribers Card in Image) -->
          <div class="z-card-white z-card-white-hover rounded-[2rem] p-6 flex flex-col justify-between h-[270px]">
            <div class="flex justify-between items-start">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-[#111113] text-xs">
                  <i class="fa-solid fa-[#111113]"></i>
                  <i class="fa-solid fa-user-check text-xs"></i>
                </div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-gray-500">Konverzije & Upiti</span>
              </div>
              <span class="text-[10px] font-bold text-gray-400 uppercase">Target 10.000</span>
            </div>

            <!-- Vertical Bar Chart in Electric Orange -->
            <div id="z-chart-subscribers-bar" class="w-full h-[100px]"></div>

            <div class="flex items-center justify-between border-t border-gray-100 pt-3">
              <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase mb-0.5">Zadnje ažuriranje prije 2 min</p>
                <h3 class="text-3xl font-black text-[#111113] tracking-tight"><%= client.advancedAnalytics.blended.totalConversions %> Leads</h3>
              </div>
              <div class="flex -space-x-2">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&fit=crop" class="w-7 h-7 rounded-full border-2 border-white object-cover" />
                <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=100&fit=crop" class="w-7 h-7 rounded-full border-2 border-white object-cover" />
                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=100&fit=crop" class="w-7 h-7 rounded-full border-2 border-white object-cover" />
              </div>
            </div>
          </div>

        </div>

        <!-- ZELLIFY BOTTOM WIDGETS ROW (MATCHING REFERENCE IMAGE BOTTOM ROW) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
          
          <!-- LEFT CARD: REVENUE BAR CHART WITH HIGHLIGHTED ORANGE BAR (Like Bottom Left Card in Image) -->
          <div class="lg:col-span-7 z-card-white z-card-white-hover rounded-[2rem] p-7 shadow-sm border border-black/5 flex flex-col justify-between h-[360px]">
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-[#111113]">
                  <i class="fa-solid fa-chart-simple text-sm"></i>
                </div>
                <h4 class="text-base font-black text-[#111113] uppercase tracking-wider">Prihod i Trend Konverzija</h4>
              </div>
              <button class="bg-gray-100 hover:bg-black hover:text-white transition-colors rounded-full px-4 py-1.5 text-xs font-bold text-gray-700 flex items-center gap-1.5">
                <span>Najveći Prihod</span>
                <i class="fa-solid fa-chevron-down text-[10px]"></i>
              </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center my-2">
              <div class="md:col-span-4">
                <div class="flex items-center gap-2 mb-2">
                  <span class="z-badge-black text-xs px-2.5 py-1">+4%</span>
                  <span class="text-xs text-gray-500 font-bold">u odnosu na prošli mjesec</span>
                </div>
                <h2 class="text-4xl font-black text-[#111113] tracking-tight">$1,730</h2>
                <p class="text-xs text-gray-500 font-semibold mt-1">Nalazite se u top 5% svih prodaja u industriji.</p>

                <div class="flex -space-x-2 mt-4">
                  <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&fit=crop" class="w-8 h-8 rounded-full border-2 border-white object-cover" />
                  <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=100&fit=crop" class="w-8 h-8 rounded-full border-2 border-white object-cover" />
                  <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=100&fit=crop" class="w-8 h-8 rounded-full border-2 border-white object-cover" />
                </div>
              </div>

              <!-- Bar Chart with Solid Vivid Orange Highlighted Bar + Pill Overlay -->
              <div class="md:col-span-8 relative">
                <div class="absolute top-2 right-[28%] z-10">
                  <span class="z-badge-black text-xs px-3 py-1 shadow-sm">20% Peak</span>
                </div>
                <div id="z-chart-revenue-highlighted" class="w-full h-[200px]"></div>
              </div>
            </div>
          </div>

          <!-- RIGHT CARD: CAMPAIGN & POSTS TABLE (Like Bottom Right Table in Image) -->
          <div class="lg:col-span-5 z-card-white z-card-white-hover rounded-[2rem] p-7 shadow-sm border border-black/5 flex flex-col justify-between h-[360px]">
            <div class="flex justify-between items-center border-b border-gray-100 pb-3">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-[#111113]">
                  <i class="fa-solid fa-list-check text-sm"></i>
                </div>
                <h4 class="text-base font-black text-[#111113] uppercase tracking-wider">Aktivne Kampanje & Performanse</h4>
              </div>
              <button class="bg-gray-100 hover:bg-black hover:text-white transition-colors rounded-full px-4 py-1.5 text-xs font-bold text-gray-700 flex items-center gap-1.5">
                <span>Spremi Prikaz</span>
                <i class="fa-solid fa-chevron-down text-[10px]"></i>
              </button>
            </div>

            <!-- Table of Campaigns -->
            <div class="overflow-x-auto my-2">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="text-gray-400 uppercase tracking-wider font-bold text-[10px]">
                    <th class="py-2 px-2">Status</th>
                    <th class="py-2 px-2">Kampanja</th>
                    <th class="py-2 px-2 text-right">Stopa Konverzije</th>
                    <th class="py-2 px-2 text-right">Prihod</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 font-bold text-[#111113]">
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="py-2.5 px-2">
                      <span class="z-badge-green px-2.5 py-0.5 text-[10px] flex items-center gap-1 w-max">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live
                      </span>
                    </td>
                    <td class="py-2.5 px-2 font-black">Ljetna Akcija 2026</td>
                    <td class="py-2.5 px-2 text-right">23.58%</td>
                    <td class="py-2.5 px-2 text-right font-black text-zorange">$4,204</td>
                  </tr>

                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="py-2.5 px-2">
                      <span class="z-badge-green px-2.5 py-0.5 text-[10px] flex items-center gap-1 w-max">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live
                      </span>
                    </td>
                    <td class="py-2.5 px-2 font-black">Google PMax Promo</td>
