<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <title><%= client ? client.name : 'Agency Portfolio' %> - ZELLIFY Marketing Dashboard</title>

  <!-- Urbanist Google Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            zdark: '#080C14',
            zbglight: '#F4F6F8',
            zlime: '#E9F52F',
            zemerald: '#111113',
            zcyan: '#0EA5E9',
            zyellow: '#F59E0B',
            zcoral: '#F43F5E',
            zorange: '#F97316',
            zorangehover: '#EA580C',
            zmuted: '#64748B'
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Apache ECharts CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>

  <!-- React 18 & ReactDOM UMD CDNs (jsDelivr High-Performance CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin="anonymous"></script>
  <!-- Babel Standalone for JSX compilation -->
  <script src="https://cdn.jsdelivr.net/npm/@babel/standalone@7.23.5/babel.min.js" crossorigin="anonymous"></script>
</head>
<body class="bg-gradient-to-b from-[#B1CEE0] via-[#E6E6E6] to-[#E6E6E6] dark:from-[#000000] dark:to-[#000000] min-h-screen text-[#0F172A] dark:text-gray-100 transition-colors duration-200 antialiased overflow-x-hidden">
  
  <!-- React Mount Point -->
  <div id="react-root"></div>

  <!-- Client-side React Dashboard Application -->
  <script type="text/babel" data-presets="react">
    const { useState, useEffect, useMemo, useRef } = React;

    // --- ACCOUNTS DATA FROM EXPRESS BACKEND ---
    const INITIAL_CLIENTS = <%- JSON.stringify(clients || []) %>;
    const SERVER_CLIENT_ID = <%- JSON.stringify(client ? client.id : null) %>;
    const IS_PORTAL_MODE = <%- JSON.stringify(typeof isPortal !== 'undefined' ? Boolean(isPortal) : false) %>;
    const PORTAL_PIN = <%- JSON.stringify(typeof portalPin !== 'undefined' && portalPin ? String(portalPin) : '1234') %>;

    const getDays = (count = 12) => Array.from({ length: count }, (_, i) => `${i + 1}.08.`);

    // --- REUSABLE ECHARTS REACT COMPONENT WITH RESIZEOBSERVER ---
    const EChartComponent = ({ option, style = { width: '100%', height: '280px' } }) => {
      const chartRef = useRef(null);
      const instanceRef = useRef(null);

      useEffect(() => {
        if (!chartRef.current) return;
        if (!instanceRef.current) {
          instanceRef.current = echarts.init(chartRef.current);
        }
        instanceRef.current.setOption(option, true);

        const resizeChart = () => {
          if (instanceRef.current) instanceRef.current.resize();
        };

        const observer = new ResizeObserver(() => resizeChart());
        observer.observe(chartRef.current);

        window.addEventListener('resize', resizeChart);
        return () => {
          observer.disconnect();
          window.removeEventListener('resize', resizeChart);
        };
      }, [option]);

      return <div ref={chartRef} style={style} className="w-full min-w-0 max-w-full" />;
    };

    // --- SKELETON LOADER COMPONENT ---
    const SkeletonCard = () => (
      <div className="z-card-white dark:bg-[#1C1C1C]/30 rounded-[2rem] p-6 animate-pulse flex flex-col justify-between h-[270px]">
        <div className="flex justify-between items-center">
          <div className="w-24 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
          <div className="w-12 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
        </div>
        <div className="w-full h-24 bg-gray-100 dark:bg-gray-800 rounded-2xl my-2"></div>
        <div className="w-32 h-6 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
      </div>
    );

    // --- MAIN REACT DASHBOARD APPLICATION ---
    function DashboardApp() {
      const [clientsList, setClientsList] = useState(INITIAL_CLIENTS);
      const [selectedAccount, setSelectedAccount] = useState(SERVER_CLIENT_ID || 'acme-corp');
      const [isPortalView, setIsPortalView] = useState(IS_PORTAL_MODE);
      const [isHomeView, setIsHomeView] = useState(IS_PORTAL_MODE ? false : (SERVER_CLIENT_ID === null));
      const [currentPin, setCurrentPin] = useState(PORTAL_PIN || '1234');
      const [isPortalModalOpen, setIsPortalModalOpen] = useState(false);
      const [copiedToast, setCopiedToast] = useState(false);
      
      const [clientTab, setClientTab] = useState('organic'); // 'organic' | 'meta-ads' | 'google-ads'
      const [organicPlatform, setOrganicPlatform] = useState('instagram'); // 'instagram' | 'facebook' | 'combined'
      const [dateRange, setDateRange] = useState('30d');
      const [isLoading, setIsLoading] = useState(false);
      const [darkMode, setDarkMode] = useState(false);

      // Handler for Generating Unique 4-digit Portal PIN
      const handleGeneratePortalPin = async (clientId) => {
        try {
          const res = await fetch('/api/client/generate-portal-pin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: clientId || selectedAccount })
          });
          const data = await res.json();
          if (data.success) {
            setCurrentPin(data.pin);
            setIsPortalModalOpen(true);
          }
        } catch (err) {
          console.error('Portal PIN generation error:', err);
          const offlinePin = Math.floor(1000 + Math.random() * 9000).toString();
          setCurrentPin(offlinePin);
          setIsPortalModalOpen(true);
        }
      };

      const handleCopyPortalUrl = (clientSlug, pin) => {
        const liveUrl = `algor.marketing/${clientSlug}/${pin}`;
        navigator.clipboard.writeText(liveUrl);
        setCopiedToast(true);
        setTimeout(() => setCopiedToast(false), 3000);
      };

      // Dynamic Time-Based Greeting for Vinko
      const greeting = useMemo(() => {
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 12) return 'Dobro jutro, Vinko';
        if (hour >= 12 && hour < 18) return 'Dobar dan, Vinko';
        return 'Dobra večer, Vinko';
      }, []);

      // DYNAMIC MONTHS LIST (January 2026 to August 2026)
      const MONTHS_LIST = useMemo(() => [
        { name: 'Siječanj 2026.', monthName: 'Siječanj', year: 2026, days: 31, startOffset: 3 },
        { name: 'Veljača 2026.', monthName: 'Veljača', year: 2026, days: 28, startOffset: 6 },
        { name: 'Ožujak 2026.', monthName: 'Ožujak', year: 2026, days: 31, startOffset: 6 },
        { name: 'Travanj 2026.', monthName: 'Travanj', year: 2026, days: 30, startOffset: 2 },
        { name: 'Svibanj 2026.', monthName: 'Svibanj', year: 2026, days: 31, startOffset: 4 },
        { name: 'Lipanj 2026.', monthName: 'Lipanj', year: 2026, days: 30, startOffset: 0 },
        { name: 'Srpanj 2026.', monthName: 'Srpanj', year: 2026, days: 31, startOffset: 2 },
        { name: 'Kolovoz 2026.', monthName: 'Kolovoz', year: 2026, days: 31, startOffset: 5 },
      ], []);

      const [activeMonthIndex, setActiveMonthIndex] = useState(7); // Default to Kolovoz 2026 (index 7)
      const currentMonthObj = MONTHS_LIST[activeMonthIndex] || MONTHS_LIST[7];

      // Leaderboard view toggle & CUSTOM VISUAL CALENDAR STATES
      const [leaderboardView, setLeaderboardView] = useState('list'); // 'list' (Table) | 'grid' (Gallery)
      const [calendarStartMonthIndex, setCalendarStartMonthIndex] = useState(7);
      const [calendarStartDay, setCalendarStartDay] = useState(1);
      const [calendarEndMonthIndex, setCalendarEndMonthIndex] = useState(7);
      const [calendarEndDay, setCalendarEndDay] = useState(31);
      const [dateSelectionMode, setDateSelectionMode] = useState('month'); // 'month' | 'single' | 'range'
      const [isCalendarOpen, setIsCalendarOpen] = useState(false);
      const [isCustomCalendarModalOpen, setIsCustomCalendarModalOpen] = useState(false);
      const [isDiagnosticOpen, setIsDiagnosticOpen] = useState(false);
      const [isPlatformMenuOpen, setIsPlatformMenuOpen] = useState(false);
      const [isDateMenuOpen, setIsDateMenuOpen] = useState(false);

      // AI Sidebar State
      const [isAiOpen, setIsAiOpen] = useState(false);
      const [aiMessages, setAiMessages] = useState([
        { 
          id: 1, 
          sender: 'ai', 
          content: 'Pozdrav Vinko! Ja sam tvoj Marketing Co-Pilot. Spreman sam za analizu učinkovitosti i optimizaciju oglasa.',
          thoughts: ['Učitavam bazu podataka i aktivne metrike...'],
          actions: [
            { label: '🔍 Analiziraj trenutni prikaz', prompt: 'Napravi brzu dijagnostiku trenutnog prikaza' },
            { label: '💡 Predloži ad copy varijante', prompt: 'Predloži 3 nova naslova za oglas s visokim CTR-om' }
          ]
        }
      ]);
      const [aiInputText, setAiInputText] = useState('');
      const [isAiTyping, setIsAiTyping] = useState(false);

      // Modal & Banner state
      const [isAddModalOpen, setIsAddModalOpen] = useState(false);
      const [isReportModalOpen, setIsReportModalOpen] = useState(false);
      const [isCreativeLabOpen, setIsCreativeLabOpen] = useState(false);
      const [isSimulatorOpen, setIsSimulatorOpen] = useState(false);
      const [isSidebarCollapsed, setIsSidebarCollapsed] = useState(false);
      const [isHubCollapsed, setIsHubCollapsed] = useState(true);
      const [bannerDismissed, setBannerDismissed] = useState(false);

      // Budget Simulator State
      const [simMetaBudget, setSimMetaBudget] = useState(2850);
      const [simGoogleBudget, setSimGoogleBudget] = useState(550);

      // Creative Lab Generator State
      const [generatedCopies, setGeneratedCopies] = useState([]);
      const [isGeneratingCopies, setIsGeneratingCopies] = useState(false);

      // Form state for Add Client Modal
      const [newClientForm, setNewClientForm] = useState({
        name: '',
        industry: '',
        targetAudience: '',
        primaryGoal: 'Lead Generation',
        targetBudget: '5000',
        targetCPA: '15.00',
        targetROAS: '4.0',
        metaBusinessId: '',
        metaAdAccountId: '',
        googleAdsId: '',
        fbPageId: '',
        igProfileId: ''
      });

      // Negative Keywords list
      const [negativeKeywords, setNegativeKeywords] = useState(['besplatno', 'torrent', 'rabljeno']);

      // Toggle Dark Mode
      useEffect(() => {
        if (darkMode) {
          document.documentElement.classList.add('dark');
          document.body.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
          document.body.classList.remove('dark');
        }
      }, [darkMode]);

      const currentClientObj = useMemo(() => {
        return (clientsList && clientsList.length > 0)
          ? (clientsList.find(c => c && c.id === selectedAccount) || clientsList[0])
          : { id: 'acme-corp', name: 'Acme Corp', logo: 'AC', package: 'Start', status: 'Healthy', industry: 'E-commerce & SaaS' };
      }, [clientsList, selectedAccount]);

      // Dynamic Diagnostic Pill & Dropdown Status (Red = Error, Orange = Suggestion, Green = Healthy)
      const clientHealthStatus = useMemo(() => {
        if (!currentClientObj) return { status: 'healthy', bgClass: 'bg-[#111113] text-white hover:bg-gray-800 shadow-md shadow-black/20 border border-black', icon: 'fa-circle-check', label: 'Dijagnostika', badgeText: 'Sve OK', badgeColor: 'bg-black text-white' };
        
        const issues = currentClientObj.atAGlance?.issues || [];
        const suggestions = currentClientObj.atAGlance?.suggestions || [];
        const healthScore = currentClientObj.healthScore || 92;

        if (issues.length > 0 || healthScore < 85) {
          return {
            status: 'error',
            bgClass: 'bg-rose-600 text-white hover:bg-rose-700 shadow-md shadow-rose-500/20 border border-rose-400',
            icon: 'fa-triangle-exclamation animate-pulse',
            label: 'Dijagnostika',
            badgeText: `⚠️ ${issues.length} Problem`,
            badgeColor: 'bg-rose-800 text-white'
          };
        } else if (suggestions.length > 0 || healthScore < 95) {
          return {
            status: 'suggestion',
            bgClass: 'bg-amber-500 text-white hover:bg-amber-600 shadow-md shadow-amber-500/20 border border-amber-400',
            icon: 'fa-lightbulb',
            label: 'Dijagnostika',
            badgeText: `💡 ${suggestions.length || 1} Prijedlog`,
            badgeColor: 'bg-amber-700 text-white'
          };
        } else {
          return {
            status: 'healthy',
            bgClass: 'bg-[#111113] text-white hover:bg-gray-800 shadow-md shadow-black/20 border border-black',
            icon: 'fa-circle-check',
            label: 'Dijagnostika',
            badgeText: '✓ Sve OK',
            badgeColor: 'bg-black text-white'
          };
        }
      }, [currentClientObj]);


      // Open Client Dashboard from Home Card
      const openClientDashboard = (clientId) => {
        setSelectedAccount(clientId);
        setIsHomeView(false);
      };

      // --- MULTI-MONTH CROSS-MONTH INTERACTIVE CALENDAR SELECTION HANDLERS ---
      const [isRangeSelecting, setIsRangeSelecting] = useState(false);

      const handleCalendarDayClick = (dayNum) => {
        const currentM = activeMonthIndex;
        const currentVal = currentM * 32 + dayNum;
        const startVal = calendarStartMonthIndex * 32 + calendarStartDay;

        if (dateSelectionMode === 'single') {
          setCalendarStartMonthIndex(currentM);
          setCalendarStartDay(dayNum);
          setCalendarEndMonthIndex(currentM);
          setCalendarEndDay(dayNum);
          setIsRangeSelecting(false);
        } else {
          if (!isRangeSelecting) {
            // First click: set start date to clicked month + day
            setCalendarStartMonthIndex(currentM);
            setCalendarStartDay(dayNum);
            setCalendarEndMonthIndex(currentM);
            setCalendarEndDay(dayNum);
            setIsRangeSelecting(true);
          } else {
            // Second click: set end date or restart if earlier date picked
            if (currentVal >= startVal) {
              setCalendarEndMonthIndex(currentM);
              setCalendarEndDay(dayNum);
              setIsRangeSelecting(false);
            } else {
              setCalendarStartMonthIndex(currentM);
              setCalendarStartDay(dayNum);
              setCalendarEndMonthIndex(currentM);
              setCalendarEndDay(dayNum);
              setIsRangeSelecting(true);
            }
          }
        }
      };

      const applyCalendarPreset = (modeKey) => {
        setDateSelectionMode(modeKey);
        setIsRangeSelecting(false);

        // Reference today: 26. Kolovoza 2026 (Month index 7 = Kolovoz, Day 26)
        const TODAY_MONTH_IDX = 7;
        const TODAY_DAY = 26;

        setActiveMonthIndex(TODAY_MONTH_IDX);

        if (modeKey === '7d') {
          // 7 days backwards: 20.08.2026. do 26.08.2026.
          setCalendarStartMonthIndex(TODAY_MONTH_IDX);
          setCalendarStartDay(20);
          setCalendarEndMonthIndex(TODAY_MONTH_IDX);
          setCalendarEndDay(TODAY_DAY);
        } else if (modeKey === '30d') {
          // 30 days backwards: 28.07.2026. do 26.08.2026.
          setCalendarStartMonthIndex(6); // Srpanj
          setCalendarStartDay(28);
          setCalendarEndMonthIndex(TODAY_MONTH_IDX);
          setCalendarEndDay(TODAY_DAY);
        } else if (modeKey === '90d') {
          // 90 days backwards: 29.05.2026. do 26.08.2026.
          setCalendarStartMonthIndex(4); // Svibanj
          setCalendarStartDay(29);
          setCalendarEndMonthIndex(TODAY_MONTH_IDX);
          setCalendarEndDay(TODAY_DAY);
        } else if (modeKey === 'month') {
          // Full current month: 01.08.2026. do 31.08.2026.
          setCalendarStartMonthIndex(TODAY_MONTH_IDX);
          setCalendarStartDay(1);
          setCalendarEndMonthIndex(TODAY_MONTH_IDX);
          setCalendarEndDay(31);
        } else if (modeKey === 'single') {
          setCalendarStartMonthIndex(TODAY_MONTH_IDX);
          setCalendarStartDay(TODAY_DAY);
          setCalendarEndMonthIndex(TODAY_MONTH_IDX);
          setCalendarEndDay(TODAY_DAY);
        }
      };

      const formatActiveDateRangeLabel = () => {
        const startMonth = MONTHS_LIST[calendarStartMonthIndex] || MONTHS_LIST[7];
        const endMonth = MONTHS_LIST[calendarEndMonthIndex] || MONTHS_LIST[7];

        if (calendarStartMonthIndex === calendarEndMonthIndex && calendarStartDay === calendarEndDay) {
          return `Datum: ${String(calendarStartDay).padStart(2, '0')}.${String(calendarStartMonthIndex + 1).padStart(2, '0')}.2026.`;
        } else if (calendarStartMonthIndex === calendarEndMonthIndex && calendarStartDay === 1 && calendarEndDay === startMonth.days) {
          return `${startMonth.monthName} (01.-${startMonth.days}.)`;
        } else {
          return `${String(calendarStartDay).padStart(2, '0')}.${String(calendarStartMonthIndex + 1).padStart(2, '0')}. do ${String(calendarEndDay).padStart(2, '0')}.${String(calendarEndMonthIndex + 1).padStart(2, '0')}.2026.`;
        }
      };

      const getSelectedDaysCount = () => {
        if (calendarStartMonthIndex === calendarEndMonthIndex) {
          return Math.max(1, calendarEndDay - calendarStartDay + 1);
        }
        let count = 0;
        for (let m = calendarStartMonthIndex; m <= calendarEndMonthIndex; m++) {
          const monthDays = MONTHS_LIST[m] ? MONTHS_LIST[m].days : 31;
          const start = (m === calendarStartMonthIndex) ? calendarStartDay : 1;
          const end = (m === calendarEndMonthIndex) ? calendarEndDay : monthDays;
          count += (end - start + 1);
        }
        return Math.max(1, count);
      };

      const isDaySelected = (dayNum, monthIdx) => {
        const val = monthIdx * 32 + dayNum;
        const startVal = calendarStartMonthIndex * 32 + calendarStartDay;
        const endVal = calendarEndMonthIndex * 32 + calendarEndDay;

        const isStart = (monthIdx === calendarStartMonthIndex && dayNum === calendarStartDay);
        const isEnd = (monthIdx === calendarEndMonthIndex && dayNum === calendarEndDay);
        const isInRange = (val >= startVal && val <= endVal);

        return { isStart, isEnd, isInRange };
      };

      // Derived ISO dates
      const leaderboardStartDate = `2026-08-${String(calendarStartDay).padStart(2, '0')}`;
      const leaderboardEndDate = `2026-08-${String(calendarEndDay).padStart(2, '0')}`;

      // --- ADD NEW CLIENT HANDLER ---
      const handleAddClientSubmit = async (e) => {
        e.preventDefault();
        if (!newClientForm.name) return;

        try {
          const res = await fetch('/api/client/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(newClientForm)
          });
          const data = await res.json();
          if (data.success && data.client) {
            setClientsList(prev => [...prev, data.client]);
            setSelectedAccount(data.client.id);
            setIsHomeView(false);
            setIsAddModalOpen(false);
          }
        } catch (err) {
          console.error(err);
          const slugId = newClientForm.name.toLowerCase().replace(/\s+/g, '-');
          const mockCreated = {
            id: slugId,
            name: newClientForm.name,
            logo: newClientForm.name.slice(0, 2).toUpperCase(),
            package: 'Enterprise',
            industry: newClientForm.industry || 'E-commerce',
            status: 'Healthy',
            stats: { reach: '10.5k', impressions: '45.2k', ctr: '3.1%', spend: `€${newClientForm.targetBudget}` },
            metaStats: { totalSpend: `€${newClientForm.targetBudget}`, cpa: `€${newClientForm.targetCPA}`, cpaTrend: { value: '5%', direction: 'down' }, resultsValue: '180 Leads' }
          };
          setClientsList(prev => [...prev, mockCreated]);
          setSelectedAccount(slugId);
          setIsHomeView(false);
          setIsAddModalOpen(false);
        }
      };

      // --- GENERATE AI AD COPIES HANDLER ---
      const handleGenerateCopies = async () => {
        setIsGeneratingCopies(true);
        try {
          const res = await fetch('/api/generate-copy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ clientId: selectedAccount })
          });
          const data = await res.json();
          if (data.success) {
            setGeneratedCopies(data.copies);
          }
        } catch (err) {
          console.error(err);
        } finally {
          setIsGeneratingCopies(false);
        }
      };

      // --- AI ASSISTANT CHAT SEND HANDLER ---
      const handleSendAiMessage = async (customPrompt) => {
        const textToSend = customPrompt || aiInputText;
        if (!textToSend.trim()) return;

        const userMsg = { id: Date.now(), sender: 'user', content: textToSend };
        setAiMessages(prev => [...prev, userMsg]);
        if (!customPrompt) setAiInputText('');
        setIsAiTyping(true);

        const aiMsgId = Date.now() + 1;
        setAiMessages(prev => [
          ...prev, 
          { 
            id: aiMsgId, 
            sender: 'ai', 
            content: '', 
            thoughts: [`Dohvaćam aktivne podatke za ${currentClientObj ? currentClientObj.name : 'Portfolio'}...`, `Analiziram metrike (${clientTab.toUpperCase()}, ${dateRange})...`] 
          }
        ]);

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: textToSend,
              clientId: selectedAccount
            })
          });

          const reader = response.body.getReader();
          const decoder = new TextDecoder('utf-8');
          let accumulatedContent = '';
          let capturedCard = null;
          let capturedSuggestions = [];

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunkStr = decoder.decode(value);
            const lines = chunkStr.split('\n\n');

            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const dataStr = line.replace('data: ', '').trim();
                if (dataStr === '[DONE]') continue;
                try {
                  const parsed = JSON.parse(dataStr);
                  if (parsed.type === 'FINAL_RESPONSE') {
                    accumulatedContent += parsed.content;
                    setAiMessages(prev => prev.map(m => m.id === aiMsgId ? { 
                      ...m, 
                      content: accumulatedContent,
                      decisionCard: capturedCard,
                      suggestions: capturedSuggestions
                    } : m));
                  } else if (parsed.type === 'DECISION_CARD') {
                    capturedCard = parsed.content;
                    setAiMessages(prev => prev.map(m => m.id === aiMsgId ? { ...m, decisionCard: capturedCard } : m));
                  } else if (parsed.type === 'SUGGESTION') {
                    capturedSuggestions.push(parsed.content);
                    setAiMessages(prev => prev.map(m => m.id === aiMsgId ? { ...m, suggestions: capturedSuggestions } : m));
                  }
                } catch (e) {}
              }
            }
          }
        } catch (err) {
          setAiMessages(prev => prev.map(m => m.id === aiMsgId ? {
            ...m,
            content: `**AI Analiza za ${currentClientObj.name}:**\n\nMetrike za **${clientTab.toUpperCase()}** (Platforma: ${organicPlatform.toUpperCase()}) pokazuju stabilne performanse uz ciljani CPA od **${currentClientObj.financialTargets ? currentClientObj.financialTargets.targetCPA : '€15.00'}**.`
          } : m));
        } finally {
          setIsAiTyping(false);
        }
      };

      const triggerAiIntervention = (promptText) => {
        setIsAiOpen(true);
        handleSendAiMessage(promptText);
      };

      const addNegativeKeyword = (kw) => {
        if (!negativeKeywords.includes(kw)) {
          setNegativeKeywords(prev => [...prev, kw]);
        }
        triggerAiIntervention(`Dodan negativni ključni izraz: "${kw}". Potvrdi optimizaciju kampanje.`);
      };

