<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= client ? client.name : 'Agency Portfolio' %> - ZELLIFY Marketing Dashboard</title>

  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            zdark: '#111113',
            zgray: '#F4F5F7',
            zorange: '#FF5F00',
            zorangehover: '#E05300',
            zmuted: '#6B7280'
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Apache ECharts CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>

  <!-- React 18 & ReactDOM UMD CDNs -->
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <!-- Babel Standalone for JSX compilation -->
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>
<body class="bg-[#F4F5F7] dark:bg-[#0B0B0C] min-h-screen text-[#111113] dark:text-gray-100 transition-colors duration-200 antialiased overflow-x-hidden">
  
  <!-- React Mount Point -->
  <div id="react-root"></div>

  <!-- Client-side React Dashboard Application -->
  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef } = React;

    // --- ACCOUNTS DATA FROM EXPRESS BACKEND ---
    const INITIAL_CLIENTS = <%- JSON.stringify(clients) %>;
    const SERVER_CLIENT_ID = <%= client ? `'${client.id}'` : 'null' %>;

    const DATE_RANGES = [
      { id: '7d', label: 'Zadnjih 7 dana (Last 7 Days)' },
      { id: '30d', label: 'Zadnjih 30 dana (Last 30 Days)' },
      { id: 'this_month', label: 'Ovaj Mjesec (This Month)' }
    ];

    const getDays = (count = 12) => Array.from({ length: count }, (_, i) => `${i + 1}.08.`);

    // --- REUSABLE ECHARTS REACT COMPONENT WITH RESIZEOBSERVER ---
    const EChartComponent = ({ option, style = { width: '100%', height: '280px' } }) => {
      const chartRef = useRef(null);
      const instanceRef = useRef(null);

      useEffect(() => {
        if (!chartRef.current) return;
        if (!instanceRef.current) {
          instanceRef.current = echarts.init(chartRef.current);
        }
        instanceRef.current.setOption(option, true);

        const resizeChart = () => {
          if (instanceRef.current) instanceRef.current.resize();
        };

        const observer = new ResizeObserver(() => resizeChart());
        observer.observe(chartRef.current);

        window.addEventListener('resize', resizeChart);
        return () => {
          observer.disconnect();
          window.removeEventListener('resize', resizeChart);
        };
      }, [option]);

      return <div ref={chartRef} style={style} className="w-full min-w-0 max-w-full" />;
    };

    // --- SKELETON LOADER COMPONENT ---
    const SkeletonCard = () => (
      <div className="z-card-white dark:bg-[#161618] rounded-[2rem] p-6 animate-pulse flex flex-col justify-between h-[270px]">
        <div className="flex justify-between items-center">
          <div className="w-24 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
          <div className="w-12 h-4 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
        </div>
        <div className="w-full h-24 bg-gray-100 dark:bg-gray-800 rounded-2xl my-2"></div>
        <div className="w-32 h-6 bg-gray-200 dark:bg-gray-700 rounded-full"></div>
      </div>
    );

    // --- MAIN REACT DASHBOARD APPLICATION ---
    function DashboardApp() {
      const [clientsList, setClientsList] = useState(INITIAL_CLIENTS);
      const [selectedAccount, setSelectedAccount] = useState(SERVER_CLIENT_ID || 'acme-corp');
      const [isHomeView, setIsHomeView] = useState(SERVER_CLIENT_ID === null);
      
      const [clientTab, setClientTab] = useState('organic'); // 'organic' | 'meta-ads' | 'google-ads'
      const [organicPlatform, setOrganicPlatform] = useState('instagram'); // 'instagram' | 'facebook' | 'combined'
      const [dateRange, setDateRange] = useState('30d');
      const [isLoading, setIsLoading] = useState(false);
      const [darkMode, setDarkMode] = useState(false);

      // Dynamic Time-Based Greeting for Vinko
      const greeting = useMemo(() => {
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 12) return 'Dobro jutro, Vinko';
        if (hour >= 12 && hour < 18) return 'Dobar dan, Vinko';
        return 'Dobra večer, Vinko';
      }, []);

      // Leaderboard view toggle & CUSTOM VISUAL CALENDAR STATES
      const [leaderboardView, setLeaderboardView] = useState('list'); // 'list' (Table) | 'grid' (Gallery)
      const [calendarStartDay, setCalendarStartDay] = useState(1);
      const [calendarEndDay, setCalendarEndDay] = useState(31);
      const [dateSelectionMode, setDateSelectionMode] = useState('month'); // 'month' | 'single' | 'range'
      const [isCalendarOpen, setIsCalendarOpen] = useState(false);

      // AI Sidebar State
      const [isAiOpen, setIsAiOpen] = useState(false);
      const [aiMessages, setAiMessages] = useState([
        { 
          id: 1, 
          sender: 'ai', 
          content: 'Pozdrav Vinko! Ja sam tvoj Marketing Co-Pilot. Spreman sam za analizu učinkovitosti i optimizaciju oglasa.',
          thoughts: ['Učitavam bazu podataka i aktivne metrike...'],
          actions: [
            { label: '🔍 Analiziraj trenutni prikaz', prompt: 'Napravi brzu dijagnostiku trenutnog prikaza' },
            { label: '💡 Predloži ad copy varijante', prompt: 'Predloži 3 nova naslova za oglas s visokim CTR-om' }
          ]
        }
      ]);
      const [aiInputText, setAiInputText] = useState('');
      const [isAiTyping, setIsAiTyping] = useState(false);

      // Modal & Banner state
      const [isAddModalOpen, setIsAddModalOpen] = useState(false);
      const [bannerDismissed, setBannerDismissed] = useState(false);

      // Form state for Add Client Modal
      const [newClientForm, setNewClientForm] = useState({
        name: '',
        industry: '',
        targetAudience: '',
        primaryGoal: 'Lead Generation',
        targetBudget: '5000',
        targetCPA: '15.00',
        targetROAS: '4.0',
        metaBusinessId: '',
        metaAdAccountId: '',
        googleAdsId: '',
        fbPageId: '',
        igProfileId: ''
      });

      // Negative Keywords list
      const [negativeKeywords, setNegativeKeywords] = useState(['besplatno', 'torrent', 'rabljeno']);

      // Toggle Dark Mode
      useEffect(() => {
        if (darkMode) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }, [darkMode]);

      const currentClientObj = useMemo(() => {
        return clientsList.find(c => c.id === selectedAccount) || clientsList[0];
      }, [clientsList, selectedAccount]);

      // Handle Client Change
      const handleAccountChange = (e) => {
        const id = e.target.value;
        if (id === 'HOME') {
          setIsHomeView(true);
          return;
        }
        setIsLoading(true);
        setSelectedAccount(id);
        setIsHomeView(false);
        setTimeout(() => setIsLoading(false), 300);
      };

      const handleDateChange = (e) => {
        setIsLoading(true);
        setDateRange(e.target.value);
        setTimeout(() => setIsLoading(false), 300);
      };

      // Open Client Dashboard from Home Card
      const openClientDashboard = (clientId) => {
        setSelectedAccount(clientId);
        setIsHomeView(false);
      };

      // --- CUSTOM INTERACTIVE CALENDAR DAY SELECTION HANDLER ---
      const handleCalendarDayClick = (dayNum) => {
        if (dateSelectionMode === 'single') {
          setCalendarStartDay(dayNum);
          setCalendarEndDay(dayNum);
        } else {
          if (calendarStartDay === calendarEndDay || dayNum < calendarStartDay) {
            setCalendarStartDay(dayNum);
            setCalendarEndDay(dayNum);
          } else {
            setCalendarEndDay(dayNum);
          }
        }
      };

      const applyCalendarPreset = (modeKey) => {
        setDateSelectionMode(modeKey);
        if (modeKey === 'month') {
          setCalendarStartDay(1);
          setCalendarEndDay(31);
        } else if (modeKey === '7d') {
          setCalendarStartDay(18);
          setCalendarEndDay(25);
        } else if (modeKey === '14d') {
          setCalendarStartDay(11);
          setCalendarEndDay(25);
        } else if (modeKey === 'single') {
          setCalendarStartDay(20);
          setCalendarEndDay(20);
        }
      };

      // Derived ISO dates
      const leaderboardStartDate = `2026-08-${String(calendarStartDay).padStart(2, '0')}`;
      const leaderboardEndDate = `2026-08-${String(calendarEndDay).padStart(2, '0')}`;

      // --- ADD NEW CLIENT HANDLER ---
      const handleAddClientSubmit = async (e) => {
        e.preventDefault();
        if (!newClientForm.name) return;

        try {
          const res = await fetch('/api/client/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(newClientForm)
          });
          const data = await res.json();
          if (data.success && data.client) {
            setClientsList(prev => [...prev, data.client]);
            setSelectedAccount(data.client.id);
            setIsHomeView(false);
            setIsAddModalOpen(false);
          }
        } catch (err) {
          console.error(err);
          const slugId = newClientForm.name.toLowerCase().replace(/\s+/g, '-');
          const mockCreated = {
            id: slugId,
            name: newClientForm.name,
            logo: newClientForm.name.slice(0, 2).toUpperCase(),
            package: 'Enterprise',
            industry: newClientForm.industry || 'E-commerce',
            status: 'Healthy',
            stats: { reach: '10.5k', impressions: '45.2k', ctr: '3.1%', spend: `$${newClientForm.targetBudget}` },
            metaStats: { totalSpend: `$${newClientForm.targetBudget}`, cpa: `$${newClientForm.targetCPA}`, cpaTrend: { value: '5%', direction: 'down' }, resultsValue: '180 Leads' }
          };
          setClientsList(prev => [...prev, mockCreated]);
          setSelectedAccount(slugId);
          setIsHomeView(false);
          setIsAddModalOpen(false);
        }
      };

      // --- AI ASSISTANT CHAT SEND HANDLER ---
      const handleSendAiMessage = async (customPrompt) => {
        const textToSend = customPrompt || aiInputText;
        if (!textToSend.trim()) return;

        const userMsg = { id: Date.now(), sender: 'user', content: textToSend };
        setAiMessages(prev => [...prev, userMsg]);
        if (!customPrompt) setAiInputText('');
        setIsAiTyping(true);

        const aiMsgId = Date.now() + 1;
        setAiMessages(prev => [
          ...prev, 
          { 
            id: aiMsgId, 
            sender: 'ai', 
            content: '', 
            thoughts: [`Dohvaćam aktivne podatke za ${currentClientObj ? currentClientObj.name : 'Portfolio'}...`, `Analiziram metrike (${clientTab.toUpperCase()}, ${dateRange})...`] 
          }
        ]);

        try {
          const response = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: textToSend,
              clientId: selectedAccount
            })
          });

          const reader = response.body.getReader();
          const decoder = new TextDecoder('utf-8');
          let accumulatedContent = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            const chunkStr = decoder.decode(value);
            const lines = chunkStr.split('\n\n');

            for (const line of lines) {
              if (line.startsWith('data: ')) {
                const dataStr = line.replace('data: ', '').trim();
                if (dataStr === '[DONE]') continue;
                try {
                  const parsed = JSON.parse(dataStr);
                  if (parsed.type === 'FINAL_RESPONSE') {
                    accumulatedContent += parsed.content;
                    setAiMessages(prev => prev.map(m => m.id === aiMsgId ? { ...m, content: accumulatedContent } : m));
                  }
                } catch (e) {}
              }
            }
          }
        } catch (err) {
          setAiMessages(prev => prev.map(m => m.id === aiMsgId ? {
            ...m,
            content: `**AI Analiza za ${currentClientObj.name}:**\n\nMetrike za **${clientTab.toUpperCase()}** (Platforma: ${organicPlatform.toUpperCase()}) pokazuju stabilne performanse uz ciljani CPA od **${currentClientObj.financialTargets ? currentClientObj.financialTargets.targetCPA : '$15.00'}**.`
          } : m));
        } finally {
          setIsAiTyping(false);
        }
      };

      const triggerAiIntervention = (promptText) => {
        setIsAiOpen(true);
        handleSendAiMessage(promptText);
      };

      const addNegativeKeyword = (kw) => {
        if (!negativeKeywords.includes(kw)) {
          setNegativeKeywords(prev => [...prev, kw]);
        }
        triggerAiIntervention(`Dodan negativni ključni izraz: "${kw}". Potvrdi optimizaciju kampanje.`);
      };

      // --- MOCK DATASETS & ECHARTS OPTIONS ---
      const mult = dateRange === '7d' ? 0.35 : dateRange === 'this_month' ? 0.85 : 1.0;

      // TAB 1: Dynamic Organic Data (Instagram, Facebook, Combined)
      const organicData = useMemo(() => {
        const isIg = organicPlatform === 'instagram';
        const isFb = organicPlatform === 'facebook';
        const isComb = organicPlatform === 'combined';

        // Dynamic Reach
        const reachVal = isIg 
          ? Math.round(128450 * mult) 
          : isFb 
          ? Math.round(195200 * mult) 
          : Math.round(323650 * mult);

        // Dynamic ERR
        const errVal = isIg ? '6.4%' : isFb ? '5.2%' : '5.8%';

        // Dynamic Growth Label & Value
        const growthLabel = isIg 
          ? 'Net Follower Growth' 
          : isFb 
          ? 'Net Page Likes' 
          : 'Net Growth (Followers & Likes)';
        const growthVal = isIg 
          ? `+${Math.round(1380 * mult)}` 
          : isFb 
          ? `+${Math.round(2140 * mult)}` 
          : `+${Math.round(3520 * mult)}`;

        // Dynamic Conversion Actions Label & Value
        const actionLabel = isIg 
          ? 'Profile & Website Taps' 
          : isFb 
          ? 'Page Views & CTA Clicks' 
          : 'Total Actions (Taps & CTA)';
        const actionVal = isIg 
          ? Math.round(3890 * mult).toLocaleString() 
          : isFb 
          ? Math.round(5120 * mult).toLocaleString() 
          : Math.round(9010 * mult).toLocaleString();

        // Chart 1: Reach vs Impressions Option
        const reachTrendOption = {
          tooltip: { trigger: 'axis' },
          legend: { data: ['Total Reach', 'Total Impressions'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700 } },
          grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
          xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: [
            { 
              name: 'Total Reach', 
              type: 'line', 
              data: (isIg 
                ? [8200, 9400, 11200, 10800, 12500, 14100, 13800, 15200, 16800, 15900, 17400, 18600] 
                : isFb 
                ? [12400, 14200, 15800, 16100, 18200, 19400, 20100, 21500, 22400, 21800, 23500, 24800] 
                : [20600, 23600, 27000, 26900, 30700, 33500, 33900, 36700, 39200, 37700, 40900, 43400]
              ).map(v => Math.round(v * mult)), 
              smooth: true, 
              lineStyle: { width: 3, color: isFb ? '#1877F2' : '#FF5F00' }, 
              areaStyle: { color: isFb ? 'rgba(24, 119, 242, 0.15)' : 'rgba(255, 95, 0, 0.15)' }, 
              itemStyle: { color: isFb ? '#1877F2' : '#FF5F00' } 
            },
            { 
              name: 'Total Impressions', 
              type: 'line', 
              data: (isIg 
                ? [24000, 27500, 31000, 29800, 34200, 38900, 37500, 41200, 44800, 42900, 46100, 49500] 
                : isFb 
                ? [38000, 41200, 45800, 44100, 49500, 52400, 51800, 56200, 59100, 58400, 62100, 65800] 
                : [62000, 68700, 76800, 73900, 83700, 91300, 89300, 97400, 103900, 101300, 108200, 115300]
              ).map(v => Math.round(v * mult)), 
              smooth: true, 
              lineStyle: { width: 3, color: darkMode ? '#E4E4E7' : '#111113' }, 
              itemStyle: { color: darkMode ? '#E4E4E7' : '#111113' } 
            }
          ]
        };

        // Chart 2: Engagement Breakdown Option
        const engagementLegend = isIg
          ? ['Saves (Core Signal)', 'Shares (Core Signal)', 'Likes', 'Comments']
          : isFb
          ? ['Shares (Virality Signal)', 'Comments (Discussion)', 'Page Reactions']
          : ['Saves & Shares', 'Comments & Discussion', 'Likes & Reactions'];

        const engagementSeries = isIg ? [
          { name: 'Saves (Core Signal)', type: 'bar', stack: 'total', data: [340, 520, 410, 680, 590, 810], itemStyle: { color: '#FF5F00' } },
          { name: 'Shares (Core Signal)', type: 'bar', stack: 'total', data: [210, 380, 290, 450, 390, 560], itemStyle: { color: darkMode ? '#E4E4E7' : '#111113' } },
          { name: 'Likes', type: 'bar', stack: 'total', data: [1200, 1850, 1420, 2100, 1950, 2600], itemStyle: { color: '#E1306C' } },
          { name: 'Comments', type: 'bar', stack: 'total', data: [180, 290, 210, 340, 280, 410], itemStyle: { color: '#1877F2', borderRadius: [4, 4, 0, 0] } }
        ] : isFb ? [
          { name: 'Shares (Virality Signal)', type: 'bar', stack: 'total', data: [450, 620, 510, 780, 690, 910], itemStyle: { color: '#1877F2' } },
          { name: 'Comments (Discussion)', type: 'bar', stack: 'total', data: [320, 480, 390, 550, 490, 660], itemStyle: { color: '#059669' } },
          { name: 'Page Reactions', type: 'bar', stack: 'total', data: [1400, 2150, 1620, 2400, 2150, 2900], itemStyle: { color: '#F59E0B', borderRadius: [4, 4, 0, 0] } }
        ] : [
          { name: 'Saves & Shares', type: 'bar', stack: 'total', data: [790, 1140, 920, 1460, 1280, 1720], itemStyle: { color: '#FF5F00' } },
          { name: 'Comments & Discussion', type: 'bar', stack: 'total', data: [500, 770, 600, 890, 770, 1070], itemStyle: { color: '#1877F2' } },
          { name: 'Likes & Reactions', type: 'bar', stack: 'total', data: [2600, 4000, 3040, 4500, 4100, 5500], itemStyle: { color: '#E1306C', borderRadius: [4, 4, 0, 0] } }
        ];

        const engagementOption = {
          tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
          legend: { data: engagementLegend, bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
          grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
          xAxis: { type: 'category', data: ['Post #1', 'Post #2', 'Post #3', 'Post #4', 'Post #5', 'Post #6'], axisLabel: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 10 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: engagementSeries
        };

        // Chart 3: Audience Health Option (New Follows/Likes vs Unfollows/Unlikes)
        const audienceHealthOption = {
          tooltip: { trigger: 'axis' },
          legend: { data: [isFb ? 'New Likes (+)' : 'New Follows (+)', isFb ? 'Unlikes (-)' : 'Unfollows (-)', 'Net Growth'], bottom: 0, textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } },
          grid: { top: 20, bottom: 40, left: 10, right: 10, containLabel: true },
          xAxis: { type: 'category', data: getDays(10), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: [
            { name: isFb ? 'New Likes (+)' : 'New Follows (+)', type: 'bar', data: [85, 110, 95, 140, 165, 150, 180, 210, 195, 230].map(v => Math.round(v * (isFb ? 1.5 : 1))), itemStyle: { color: '#059669', borderRadius: [4, 4, 0, 0] } },
            { name: isFb ? 'Unlikes (-)' : 'Unfollows (-)', type: 'bar', data: [-18, -24, -20, -32, -28, -25, -30, -35, -29, -38].map(v => Math.round(v * (isFb ? 1.5 : 1))), itemStyle: { color: '#EF4444', borderRadius: [0, 0, 4, 4] } },
            { name: 'Net Growth', type: 'line', data: [67, 86, 75, 108, 137, 125, 150, 175, 166, 192].map(v => Math.round(v * (isFb ? 1.5 : 1))), smooth: true, lineStyle: { width: 3, color: isFb ? '#1877F2' : '#FF5F00' }, itemStyle: { color: isFb ? '#1877F2' : '#FF5F00' } }
          ]
        };

        // NEW CHART 4: Profile Activity & Traffic Intent (Dual Area Chart)
        const profileVisitsData = [450, 520, 610, 590, 680, 750, 720, 810, 890, 840, 920, 980].map(v => Math.round(v * mult));
        const ctaClicksData = [68, 84, 102, 95, 115, 132, 126, 148, 165, 152, 171, 186].map(v => Math.round(v * mult));

        const trafficIntentOption = {
          tooltip: {
            trigger: 'axis',
            formatter: (params) => {
              let dateStr = params[0].name;
              let visits = 0;
              let clicks = 0;
              let res = `<div style="font-weight:900;margin-bottom:4px;">${dateStr}</div>`;
              params.forEach(p => {
                if (p.seriesName === 'Profile Visits') visits = p.value;
                if (p.seriesName === 'Website Taps / CTA Clicks') clicks = p.value;
                res += `<div style="font-size:12px;"><span style="display:inline-block;margin-right:5px;border-radius:10px;width:10px;height:10px;background-color:${p.color};"></span>${p.seriesName}: <strong>${p.value.toLocaleString()}</strong></div>`;
              });
              if (visits > 0) {
                const convRate = ((clicks / visits) * 100).toFixed(1);
                res += `<div style="margin-top:6px;padding-top:4px;border-top:1px solid #eee;color:#FF5F00;font-weight:900;font-size:11px;">📈 Traffic Conversion Rate: ${convRate}% (Visits → Clicks)</div>`;
              }
              return res;
            }
          },
          legend: { 
            data: ['Profile Visits', 'Website Taps / CTA Clicks'], 
            bottom: 0, 
            textStyle: { color: darkMode ? '#A1A1AA' : '#111113', fontWeight: 700, fontSize: 11 } 
          },
          grid: { top: 20, bottom: 45, left: 10, right: 15, containLabel: true },
          xAxis: { type: 'category', data: getDays(12), axisLabel: { color: '#6B7280', fontSize: 10 } },
          yAxis: { type: 'value', axisLabel: { color: '#6B7280', fontSize: 10 } },
          series: [
            {
              name: 'Profile Visits',
              type: 'line',
              smooth: true,
              data: profileVisitsData,
              lineStyle: { width: 3, color: '#1877F2' },
              areaStyle: { color: 'rgba(24, 119, 242, 0.2)' },
              itemStyle: { color: '#1877F2' }
            },
            {
              name: 'Website Taps / CTA Clicks',
              type: 'line',
              smooth: true,
              data: ctaClicksData,
              lineStyle: { width: 3, color: '#FF5F00' },
              areaStyle: { color: 'rgba(255, 95, 0, 0.15)' },
              itemStyle: { color: '#FF5F00' }
            }
          ]
        };

        // NEW CHART 5: Performance by Content Format (Horizontal Grouped Bar Chart)
        const formatCategories = isFb 
          ? ['Link Post', 'Single Image', 'Carousel', 'Reels / Video']
