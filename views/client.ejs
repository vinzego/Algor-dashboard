    /* ----------------------------------------------------
       AI ASSISTANT CHAT FRONTEND LOGIC (SSE PARSER)
       ---------------------------------------------------- */
    function adjustInputHeight(textarea) {
      textarea.style.height = '38px';
      const scrollHeight = textarea.scrollHeight;
      if (scrollHeight > 38) {
        textarea.style.height = Math.min(scrollHeight, 120) + 'px';
      }
    }

    function handleInputKeydown(event) {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        document.getElementById('chat-form').requestSubmit();
      }
    }

    function sendSuggestion(text) {
      const input = document.getElementById('chat-input');
      input.value = text;
      adjustInputHeight(input);
      document.getElementById('chat-form').requestSubmit();
    }

    async function handleChatSubmit(event) {
      event.preventDefault();
      
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text) return;
      
      input.value = '';
      adjustInputHeight(input);
      
      const chatMessages = document.getElementById('chat-messages');

      const userBubble = document.createElement('div');
      userBubble.className = 'flex items-start gap-2.5 max-w-[85%] ml-auto justify-end';
      userBubble.innerHTML = `
        <div class="bg-brand-dark text-white p-3 rounded-2xl rounded-tr-none shadow-sm leading-relaxed">
          ${escapeHtml(text)}
        </div>
      `;
      chatMessages.appendChild(userBubble);
      scrollToBottom();

      const assistantBubble = document.createElement('div');
      assistantBubble.className = 'flex items-start gap-2.5 max-w-[85%]';
      
      const uniqueMsgId = 'assistant-msg-' + Date.now();
      const uniqueThoughtId = 'thought-log-' + Date.now();
      const uniqueContentId = 'content-log-' + Date.now();
      
      assistantBubble.innerHTML = `
        <div class="w-8 h-8 rounded-lg bg-brand-dark/10 flex items-center justify-center border border-brand-dark/15 shrink-0">
          <i class="fa-solid fa-robot text-brand-dark text-xs"></i>
        </div>
        <div id="${uniqueMsgId}" class="glass-panel p-3.5 rounded-2xl rounded-tl-none text-brand-dark font-medium shadow-sm leading-relaxed w-full border border-brand-dark/15">
          <div id="${uniqueThoughtId}" class="text-xs text-brand-dark/75 border-b border-brand-dark/10 pb-2 mb-2">
            <span class="inline-flex items-center gap-1.5 font-bold uppercase tracking-wider">
              <i class="fa-solid fa-circle-notch animate-spin text-brand-dark"></i> Razmišljanje...
            </span>
            <div class="thought-steps mt-1 font-medium italic space-y-0.5"></div>
          </div>
          <div id="${uniqueContentId}" class="prose max-w-none text-xs md:text-sm leading-relaxed space-y-1 text-brand-dark font-medium"></div>
        </div>
      `;
      
      chatMessages.appendChild(assistantBubble);
      scrollToBottom();

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: text,
            history: conversationHistory,
            clientId: clientId
          })
        });

        if (!response.ok) {
          throw new Error('Mrežna greška.');
        }

        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        
        const thoughtBox = assistantBubble.querySelector(`#${uniqueThoughtId}`);
        const thoughtStepsContainer = thoughtBox.querySelector('.thought-steps');
        const contentBox = assistantBubble.querySelector(`#${uniqueContentId}`);
        
        let finalResponseBuffer = '';
        let newSuggestions = [];

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          const chunk = decoder.decode(value);
          const lines = chunk.split('\n');

          for (const line of lines) {
            if (line.startsWith('data: ')) {
              const dataStr = line.slice(6).trim();
              if (dataStr === '[DONE]') break;

              try {
                const data = JSON.parse(dataStr);
                
                if (data.type === 'THOUGHT') {
                  const step = document.createElement('div');
                  step.textContent = '• ' + data.content;
                  thoughtStepsContainer.appendChild(step);
                  scrollToBottom();
                } 
                else if (data.type === 'FINAL_RESPONSE') {
                  finalResponseBuffer += data.content;
                  contentBox.innerHTML = renderSimpleMarkdown(finalResponseBuffer);
                  scrollToBottom();
                }
                else if (data.type === 'SUGGESTION') {
                  newSuggestions.push(data.content);
                }
              } catch (e) {
                // Ignore parsing errors
              }
            }
          }
        }

        const spinnerIcon = thoughtBox.querySelector('.fa-circle-notch');
        if (spinnerIcon) {
          spinnerIcon.className = 'fa-solid fa-circle-check text-emerald-600';
        }

        updateSuggestions(newSuggestions);

        conversationHistory.push({ role: 'user', content: text });
        conversationHistory.push({ role: 'model', content: finalResponseBuffer });

      } catch (err) {
        console.error(err);
        const contentBox = assistantBubble.querySelector(`#${uniqueContentId}`);
        contentBox.innerHTML = `<span class="text-rose-600 font-bold"><i class="fa-solid fa-triangle-exclamation"></i> Greška.</span>`;
        const thoughtBox = assistantBubble.querySelector(`#${uniqueThoughtId}`);
        if (thoughtBox) thoughtBox.classList.add('hidden');
        scrollToBottom();
      }
    }

    function scrollToBottom() {
      const chatMessages = document.getElementById('chat-messages');
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function updateSuggestions(suggestions) {
      const container = document.getElementById('suggestion-container');
      container.innerHTML = '';
      
      if (!suggestions || suggestions.length === 0) return;
      
      suggestions.forEach(sug => {
        const btn = document.createElement('button');
        btn.onclick = () => sendSuggestion(sug);
        btn.className = 'text-xs font-bold text-brand-dark/90 hover:text-brand-dark bg-white/80 hover:bg-white border border-brand-dark/20 px-2.5 py-1 rounded-full transition-all duration-300 shadow-sm';
        btn.textContent = sug;
        container.appendChild(btn);
      });
    }

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderSimpleMarkdown(md) {
      let html = md;
      html = escapeHtml(html);
      html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/^### (.*?)$/gm, '<h5 class="text-sm font-black text-brand-dark mt-2.5 mb-1">$1</h5>');
      html = html.replace(/^## (.*?)$/gm, '<h4 class="text-base font-black text-brand-dark mt-3 mb-1">$1</h4>');
      html = html.replace(/^- (.*?)$/gm, '<li class="ml-3 list-disc pl-0.5 font-medium">$1</li>');

      const tableRegex = /\|([\s\S]*?)\|/g;
      if (html.includes('|')) {
        const lines = html.split('\n');
        let inTable = false;
        let tableRows = '';
        
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i].trim();
          if (line.startsWith('|') && line.endsWith('|')) {
            if (line.includes('---')) continue;
            inTable = true;
            const cells = line.split('|').slice(1, -1).map(c => c.trim());
            const rowTag = tableRows === '' ? 'th' : 'td';
            const rowContent = cells.map(c => `<${rowTag} class="px-2.5 py-1 border border-brand-dark/20 text-left font-bold">${c}</${rowTag}>`).join('');
            tableRows += `<tr class="border-b border-brand-dark/15">${rowContent}</tr>`;
          } else {
            if (inTable) {
              html = html.replace(/\|[\s\S]*?\|/, `<table class="w-full text-xs border border-brand-dark/15 border-collapse my-2">${tableRows}</table>`);
              inTable = false;
              tableRows = '';
            }
          }
        }
        if (inTable) {
          html = html.replace(/\|[\s\S]*?\|/, `<table class="w-full text-xs border border-brand-dark/15 border-collapse my-2">${tableRows}</table>`);
        }
      }
      html = html.replace(/\n\n/g, '<div class="h-2"></div>');
      return html;
    }
  </script>
