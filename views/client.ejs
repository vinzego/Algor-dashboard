        <section id="panel-social" class="hidden transition-all duration-300">
          
          <!-- Header Banner -->
          <div class="glass-panel rounded-[2rem] p-6 mb-6 shadow-md border border-brand-dark/15 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div class="flex items-center gap-3.5">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-pink to-brand-cyan flex items-center justify-center text-brand-dark text-xl font-black shadow-sm">
