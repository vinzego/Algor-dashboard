          ]
        });
      }

      const tikVidElem = document.getElementById('tiktok-chart-videos');
      if (tikVidElem) {
        tiktokVideosChart = echarts.init(tikVidElem);
        tiktokVideosChart.setOption({
          tooltip: { trigger: 'axis' },
          xAxis: { type: 'value' },
          yAxis: { type: 'category', data: ['TikTok Video 1', 'TikTok Video 2', 'TikTok Video 3', 'TikTok Video 4'] },
          series: [{ type: 'bar', data: [340, 520, 210, 480], itemStyle: { color: '#FF5F00', borderRadius: [0, 5, 5, 0] } }]
        });
      }
    }

    // Window resize listener
    window.addEventListener('resize', () => {
      if (mfrGaugeChart) mfrGaugeChart.resize();
      if (revenueSparklineChart) revenueSparklineChart.resize();
      if (subscribersBarChart) subscribersBarChart.resize();
      if (revenueHighlightedChart) revenueHighlightedChart.resize();

      if (chartReachImpressions) chartReachImpressions.resize();
      if (chartErrRate) chartErrRate.resize();
      if (chartSavesShares) chartSavesShares.resize();
      if (chartFollowerGrowth) chartFollowerGrowth.resize();
      if (chartProfileVisits) chartProfileVisits.resize();

      if (metaCardGaugeChart) metaCardGaugeChart.resize();
      if (metaCardSparkChart) metaCardSparkChart.resize();
      if (metaCardBarChart) metaCardBarChart.resize();

      if (chartMetaRoasCpa) chartMetaRoasCpa.resize();
      if (chartMetaCtrLinkAll) chartMetaCtrLinkAll.resize();
      if (chartMetaCpcCpm) chartMetaCpcCpm.resize();
      if (chartMetaFrequency) chartMetaFrequency.resize();
      if (chartMetaHookHold) chartMetaHookHold.resize();
      if (chartMetaLandingClicks) chartMetaLandingClicks.resize();
      if (chartMetaConversionRate) chartMetaConversionRate.resize();
      if (chartMetaCac) chartMetaCac.resize();

      if (googleEfficiencyChart) googleEfficiencyChart.resize();
      if (googleNetworksChart) googleNetworksChart.resize();

      if (tiktokEfficiencyChart) tiktokEfficiencyChart.resize();
      if (tiktokVideosChart) tiktokVideosChart.resize();

      if (socialPlatformsChart) socialPlatformsChart.resize();
      if (socialFormatsChart) socialFormatsChart.resize();
    });

    // Tab switching logic (ZELLIFY Capsule Navigation)
    function switchPlatform(platform) {
      const btn360 = document.getElementById('btn-360');
      const btnMeta = document.getElementById('btn-meta');
      const btnGoogle = document.getElementById('btn-google');
      const btnTiktok = document.getElementById('btn-tiktok');
      const btnSocial = document.getElementById('btn-social');
      
      const panelAdvanced = document.getElementById('panel-advanced-analytics');
      const panelMeta = document.getElementById('panel-meta');
      const panelGoogle = document.getElementById('panel-google');
      const panelTiktok = document.getElementById('panel-tiktok');
      const panelSocial = document.getElementById('panel-social');

      // Helper reset all panels
      const panels = [panelAdvanced, panelMeta, panelGoogle, panelTiktok, panelSocial];
      panels.forEach(p => {
        if (p) {
          p.classList.add('hidden');
          p.classList.remove('opacity-100', 'scale-100');
          p.classList.add('opacity-0', 'scale-95');
        }
      });

      // Reset all navigation buttons
      const buttons = [btn360, btnMeta, btnGoogle, btnTiktok, btnSocial];
      buttons.forEach(b => {
        if (b) b.className = 'z-pill-nav-item px-4 py-2 text-xs transition-all duration-200';
      });

      // 1. Dashboard (360° Overview)
      if (platform === '360') {
        if (btn360) btn360.className = 'z-pill-nav-item-active px-5 py-2 text-xs transition-all duration-200';
        
        if (panelAdvanced) {
          panelAdvanced.classList.remove('hidden');
          setTimeout(() => {
            panelAdvanced.classList.remove('opacity-0', 'scale-95');
            panelAdvanced.classList.add('opacity-100', 'scale-100');
            if (mfrGaugeChart) mfrGaugeChart.resize();
            if (revenueSparklineChart) revenueSparklineChart.resize();
            if (subscribersBarChart) subscribersBarChart.resize();
            if (revenueHighlightedChart) revenueHighlightedChart.resize();

            if (chartReachImpressions) chartReachImpressions.resize();
            if (chartErrRate) chartErrRate.resize();
            if (chartSavesShares) chartSavesShares.resize();
            if (chartFollowerGrowth) chartFollowerGrowth.resize();
            if (chartProfileVisits) chartProfileVisits.resize();
          }, 50);
        }
      }

      // 2. Meta Ads
      else if (platform === 'meta') {
        if (btnMeta) btnMeta.className = 'z-pill-nav-item-active px-5 py-2 text-xs transition-all duration-200';
        
        if (panelMeta) {
          panelMeta.classList.remove('hidden');
          panelMeta.classList.remove('opacity-0', 'scale-95');
          panelMeta.classList.add('opacity-100', 'scale-100');

          initMetaCharts();
          setTimeout(resizeMetaCharts, 50);
          setTimeout(resizeMetaCharts, 250);
        }
      }
      
      // 3. Google Ads (Performance Max Focus)
      else if (platform === 'google') {
        if (btnGoogle) btnGoogle.className = 'z-pill-nav-item-active px-5 py-2 text-xs transition-all duration-200';

        if (panelGoogle) {
          panelGoogle.classList.remove('hidden');
          setTimeout(() => {
            panelGoogle.classList.remove('opacity-0', 'scale-95');
            panelGoogle.classList.add('opacity-100', 'scale-100');
            if (googleEfficiencyChart) googleEfficiencyChart.resize();
            if (googleNetworksChart) googleNetworksChart.resize();
          }, 50);
        }
      }
      
      // 4. TikTok Ads
      else if (platform === 'tiktok') {
        if (btnTiktok) btnTiktok.className = 'z-pill-nav-item-active px-5 py-2 text-xs transition-all duration-200';

        if (panelTiktok) {
          panelTiktok.classList.remove('hidden');
          setTimeout(() => {
            panelTiktok.classList.remove('opacity-0', 'scale-95');
            panelTiktok.classList.add('opacity-100', 'scale-100');
            if (tiktokEfficiencyChart) tiktokEfficiencyChart.resize();
            if (tiktokVideosChart) tiktokVideosChart.resize();
          }, 50);
        }
      }

      // 5. Social Media (Objave & Sadržaj)
      else if (platform === 'social') {
        if (btnSocial) btnSocial.className = 'z-pill-nav-item-active px-5 py-2 text-xs transition-all duration-200';

        if (panelSocial) {
          panelSocial.classList.remove('hidden');
          setTimeout(() => {
            panelSocial.classList.remove('opacity-0', 'scale-95');
            panelSocial.classList.add('opacity-100', 'scale-100');
            if (socialPlatformsChart) socialPlatformsChart.resize();
            if (socialFormatsChart) socialFormatsChart.resize();
          }, 50);
        }
      }
    }

    // Active platform filter state
    let activePlatformFilter = 'all';
    let pickerInstance = null;

    // Initialize Modern Flatpickr Date Picker (Default: Current Month)
    function initDateFilter() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const firstDay = `${year}-${month}-01`;
      const lastDayNum = new Date(year, now.getMonth() + 1, 0).getDate();
      const lastDay = `${year}-${month}-${String(lastDayNum).padStart(2, '0')}`;

      pickerInstance = flatpickr("#date-range-picker", {
        mode: "range",
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d.m.Y.",
        defaultDate: [firstDay, lastDay],
        locale: flatpickr.l10ns.hr || "hr",
        onChange: function(selectedDates, dateStr, instance) {
          applyFilters();
        }
      });

      applyFilters();
    }

    // Set Date Range Presets
    function setDatePreset(preset) {
      if (!pickerInstance) return;

      if (preset === 'month') {
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const firstDay = `${year}-${month}-01`;
        const lastDayNum = new Date(year, now.getMonth() + 1, 0).getDate();
        const lastDay = `${year}-${month}-${String(lastDayNum).padStart(2, '0')}`;
        pickerInstance.setDate([firstDay, lastDay]);
      } else if (preset === '7days') {
        const today = new Date();
        const sevenDaysAgo = new Date();
        sevenDaysAgo.setDate(today.getDate() - 7);
        pickerInstance.setDate([sevenDaysAgo, today]);
      } else if (preset === 'all') {
        pickerInstance.clear();
      }
      applyFilters();
    }

    // Filter Posts by Platform
    function setPlatformFilter(platform) {
      activePlatformFilter = platform;
      const filterBtns = ['all', 'instagram', 'facebook', 'tiktok'];
      filterBtns.forEach(p => {
        const btn = document.getElementById(`post-filter-${p}`);
        if (btn) {
          if (p === platform) {
            btn.className = 'px-4 py-2 rounded-full bg-[#111113] text-white shadow-xs font-black transition-all';
          } else {
            btn.className = 'px-4 py-2 rounded-full text-gray-700 hover:text-[#111113] transition-all font-black flex items-center gap-1.5';
          }
        }
      });
      applyFilters();
    }

    // Apply combined Platform & Date filters to Table and Gallery
    function applyFilters() {
      let startDateVal = '';
      let endDateVal = '';

      if (pickerInstance && pickerInstance.selectedDates.length > 0) {
        const d1 = pickerInstance.selectedDates[0];
        startDateVal = d1.toISOString().split('T')[0];
        if (pickerInstance.selectedDates.length > 1) {
          const d2 = pickerInstance.selectedDates[1];
          endDateVal = d2.toISOString().split('T')[0];
        } else {
          endDateVal = startDateVal; // single date selected
        }
      }

      // Filter Table Rows
      const tableRows = document.querySelectorAll('.post-row-item');
      tableRows.forEach(row => {
        const plat = (row.getAttribute('data-platform') || '').toLowerCase();
        const postDate = row.getAttribute('data-date') || '';

        const matchesPlatform = activePlatformFilter === 'all' || plat.includes(activePlatformFilter);
        let matchesDate = true;
        if (startDateVal && postDate < startDateVal) matchesDate = false;
        if (endDateVal && postDate > endDateVal) matchesDate = false;

        if (matchesPlatform && matchesDate) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      // Filter Gallery Cards
      const galleryCards = document.querySelectorAll('.post-card-item');
      galleryCards.forEach(card => {
        const plat = (card.getAttribute('data-platform') || '').toLowerCase();
        const postDate = card.getAttribute('data-date') || '';

        const matchesPlatform = activePlatformFilter === 'all' || plat.includes(activePlatformFilter);
        let matchesDate = true;
        if (startDateVal && postDate < startDateVal) matchesDate = false;
        if (endDateVal && postDate > endDateVal) matchesDate = false;

        if (matchesPlatform && matchesDate) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Switch Posts View Mode (Table vs Gallery)
    function switchPostsView(viewMode) {
      const btnTable = document.getElementById('btn-view-table');
      const btnGallery = document.getElementById('btn-view-gallery');
      const viewTable = document.getElementById('posts-view-table');
      const viewGallery = document.getElementById('posts-view-gallery');

      if (viewMode === 'table') {
        btnTable.className = 'px-3 py-1.5 rounded-full bg-white text-[#111113] shadow-xs font-black transition-all flex items-center gap-1.5';
        btnGallery.className = 'px-3 py-1.5 rounded-full text-gray-600 hover:text-[#111113] transition-all flex items-center gap-1.5';
        viewTable.classList.remove('hidden');
        viewGallery.classList.add('hidden');
      } else {
        btnGallery.className = 'px-3 py-1.5 rounded-full bg-white text-[#111113] shadow-xs font-black transition-all flex items-center gap-1.5';
        btnTable.className = 'px-3 py-1.5 rounded-full text-gray-600 hover:text-[#111113] transition-all flex items-center gap-1.5';
        viewGallery.classList.remove('hidden');
        viewTable.classList.add('hidden');
      }
    }

    // Toggle Notification Popover Dropdown
    function toggleNotifications() {
      const popover = document.getElementById('dropdown-notifications');
      if (popover) {
        popover.classList.toggle('hidden');
      }
    }

    // Close notification dropdown when clicking outside
    document.addEventListener('click', (e) => {
      const btn = document.getElementById('btn-notifications');
      const popover = document.getElementById('dropdown-notifications');
      if (popover && !popover.classList.contains('hidden')) {
        if (!popover.contains(e.target) && btn && !btn.contains(e.target)) {
          popover.classList.add('hidden');
        }
      }
    });
  </script>
</body>
</html>
