            <!-- Card 1: Published Posts Count -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[150px] shadow-sm sm:col-span-6 xl:col-span-3">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Objavljene objave</p>
