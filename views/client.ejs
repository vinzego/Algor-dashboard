<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= client.name %> - Marketing Dashboard</title>
  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              dark: '#122022',
              green: '#DAF4AA',
              cyan: '#96D8D0',
              pink: '#F1B4B9'
            }
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Apache ECharts CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>
</head>
<body class="min-h-screen relative pb-16">

  <!-- Background Decorative Glowing Blobs -->
  <div class="bg-glow-green top-[-100px] left-[-100px]"></div>
  <div class="bg-glow-pink bottom-[-100px] right-[-100px]"></div>

  <div class="w-full px-6 sm:px-8 lg:px-12">
    
    <!-- Floating Pill Navbar with client detail context -->
    <header class="pt-6">
      <nav class="glass-navbar rounded-full px-6 py-3 flex items-center justify-between shadow-lg">
        
        <!-- Left: Logo & Back Button -->
        <div class="flex items-center gap-4">
          <a href="/" class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-dark/5 border border-brand-dark/10 text-brand-dark hover:bg-brand-dark hover:text-white transition-all duration-300">
            <i class="fa-solid fa-arrow-left text-xs"></i>
          </a>
          <div class="hidden sm:flex items-center gap-2 border-l border-brand-dark/15 pl-4">
            <span class="font-black tracking-wider text-xs px-2 py-0.5 rounded bg-brand-dark text-white"><%= client.logo %></span>
            <span class="text-sm font-bold text-brand-dark"><%= client.name %></span>
          </div>
        </div>
        
        <!-- Center: Platform Switcher (5 Unlocked View Modes) -->
        <div class="flex items-center bg-brand-dark/5 p-1 rounded-full border border-brand-dark/15 flex-wrap gap-1">
          <button id="btn-360" class="px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 bg-brand-dark text-white shadow-sm flex items-center gap-1.5" onclick="switchPlatform('360')">
            <i class="fa-solid fa-globe text-xs"></i> 360° Pregled
          </button>

          <button id="btn-meta" class="px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 text-brand-dark/80 hover:text-brand-dark flex items-center gap-1.5" onclick="switchPlatform('meta')">
            <i class="fa-brands fa-meta text-xs text-blue-600"></i> Meta Ads
          </button>
          
          <button id="btn-google" class="px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 text-brand-dark/80 hover:text-brand-dark flex items-center gap-1.5" onclick="switchPlatform('google')">
            <i class="fa-brands fa-google text-xs text-rose-500"></i> Google Ads (PMax)
          </button>
          
          <button id="btn-tiktok" class="px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 text-brand-dark/80 hover:text-brand-dark flex items-center gap-1.5" onclick="switchPlatform('tiktok')">
            <i class="fa-brands fa-tiktok text-xs text-black"></i> TikTok Ads
          </button>

          <button id="btn-social" class="px-4 py-1.5 rounded-full text-xs font-extrabold transition-all duration-300 text-brand-dark/80 hover:text-brand-dark flex items-center gap-1.5" onclick="switchPlatform('social')">
            <i class="fa-solid fa-photo-film text-xs"></i> Objave & Sadržaj
          </button>
        </div>
        
        <!-- Right: Profile Info -->
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-full bg-brand-dark/10 flex items-center justify-center border border-brand-dark/15">
            <i class="fa-solid fa-user text-brand-dark text-sm"></i>
          </div>
        </div>
      </nav>
    </header>

    <!-- 80/20 Layout Split Container -->
    <div class="flex flex-col lg:flex-row gap-6 mt-12 items-start">
      
      <!-- LEFT COLUMN: Client Dashboard (80% of width) -->
      <main class="flex-1 lg:w-[76%] xl:w-[79%] min-w-0">

        <!-- Package Info Card (Informative Badge, No Locks!) -->
        <div class="glass-panel rounded-[2rem] p-6 mb-6 shadow-md flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex items-center gap-4 shrink-0">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center font-extrabold text-xl border <%= client.accentClass %> <%= client.bgAccentClass %> shadow-sm">
              <%= client.logo %>
            </div>
            <div>
              <h3 class="text-2xl font-black text-brand-dark"><%= client.name %></h3>
              <p class="text-xs text-brand-dark/75 font-bold mt-1">Paket suradnje: 
                <span class="px-2.5 py-1 rounded text-xs font-black uppercase tracking-wider border shadow-sm
                  <%= client.package === 'Ultra' ? 'bg-gradient-to-tr from-brand-pink/30 to-brand-cyan/30 border-brand-pink/50 text-brand-dark' : '' %>
                  <%= client.package === 'Pro' ? 'bg-brand-cyan/25 text-brand-dark border-brand-cyan/50' : '' %>
                  <%= client.package === 'Start' ? 'bg-brand-dark/10 text-brand-dark border-brand-dark/20' : '' %>">
                  <%= client.package %> (Nivo Usluge)
                </span>
              </p>
            </div>
          </div>
          
          <!-- Mid: Posts published status (Enlarged) -->
          <div class="flex-grow max-w-md w-full bg-brand-dark/5 rounded-2xl p-4 border border-brand-dark/10">
            <div class="flex justify-between items-center text-xs md:text-sm text-brand-dark/80 font-bold mb-2">
              <span class="flex items-center gap-1.5"><i class="fa-solid fa-calendar-check text-brand-dark/70"></i> Mjesečni plan objava:</span>
              <span class="text-brand-dark font-black"><%= client.publishedPosts %> / <%= client.maxPosts %> objavljeno</span>
            </div>
            <div class="w-full bg-brand-dark/10 rounded-full h-3 overflow-hidden">
              <% const pctVal = Math.min((client.publishedPosts / client.maxPosts) * 100, 100); %>
              <div class="bg-brand-dark h-3 rounded-full transition-all duration-500" style="width: <%= pctVal %>%; background-color: <%= client.accentColor === '#DAF4AA' ? '#558B2F' : (client.accentColor === '#FFFFFF' ? '#122022' : client.accentColor) %>"></div>
            </div>
          </div>
        </div>

        <!-- EXECUTIVE HEALTH SUMMARY & ACTION PLAN BANNER (Na prvi pogled: Što valja / Što ne valja / Kako popraviti) -->
        <div class="glass-panel rounded-[2rem] p-6 mb-6 shadow-md border border-brand-dark/15">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 border-b border-brand-dark/15 pb-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand-cyan to-brand-green flex items-center justify-center text-brand-dark font-black text-lg shadow-sm">
                <i class="fa-solid fa-heart-pulse"></i>
              </div>
              <div>
                <h4 class="text-base font-black text-brand-dark uppercase tracking-wider">Brzi uvid u zdravlje marketinga (At-A-Glance Status)</h4>
                <p class="text-xs text-brand-dark/75 font-bold">Što funkcionira, što zahtijeva pažnju i što poduzeti za brzi napredak</p>
              </div>
            </div>
            <span class="px-4 py-1.5 rounded-full text-xs font-black uppercase bg-emerald-100 text-emerald-900 border border-emerald-300 shadow-sm self-start md:self-auto">
              Ukupni Status: <%= client.executiveHealthCheck.overallHealth %>
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            
            <!-- Column 1: What Works Great (Što valja) -->
            <div class="bg-emerald-500/10 rounded-2xl p-4 border border-emerald-500/20 shadow-sm">
              <div class="flex items-center gap-2 mb-3 pb-2 border-b border-emerald-500/15">
                <i class="fa-solid fa-circle-check text-emerald-700 text-sm"></i>
                <h5 class="text-xs font-black text-emerald-950 uppercase tracking-wider">🟢 Što odlično funkcionira</h5>
              </div>
              <ul class="space-y-2.5">
                <% client.executiveHealthCheck.goodHighlights.forEach(item => { %>
                  <li class="text-xs font-bold text-emerald-950 leading-relaxed bg-white/70 p-2.5 rounded-xl border border-emerald-500/15 shadow-2xs">
                    <strong class="block text-emerald-900 mb-0.5"><%= item.title %></strong>
                    <%= item.desc %>
                  </li>
                <% }); %>
              </ul>
            </div>

            <!-- Column 2: What Needs Attention (Što ne valja) -->
            <div class="bg-rose-500/10 rounded-2xl p-4 border border-rose-500/20 shadow-sm">
              <div class="flex items-center gap-2 mb-3 pb-2 border-b border-rose-500/15">
                <i class="fa-solid fa-triangle-exclamation text-rose-700 text-sm"></i>
                <h5 class="text-xs font-black text-rose-950 uppercase tracking-wider">🔴 Što ne valja (Zahtijeva pažnju)</h5>
              </div>
              <ul class="space-y-2.5">
                <% client.executiveHealthCheck.criticalIssues.forEach(item => { %>
                  <li class="text-xs font-bold text-rose-950 leading-relaxed bg-white/70 p-2.5 rounded-xl border border-rose-500/15 shadow-2xs">
                    <strong class="block text-rose-900 mb-0.5"><%= item.title %></strong>
                    <%= item.desc %>
                  </li>
                <% }); %>
              </ul>
            </div>

            <!-- Column 3: Actionable Fixes (Kako popraviti) -->
            <div class="bg-brand-cyan/15 rounded-2xl p-4 border border-brand-cyan/30 shadow-sm">
              <div class="flex items-center gap-2 mb-3 pb-2 border-b border-brand-dark/15">
                <i class="fa-solid fa-wand-magic-sparkles text-brand-dark text-sm"></i>
                <h5 class="text-xs font-black text-brand-dark uppercase tracking-wider">💡 Preporučeni brzi popravak</h5>
              </div>
              <ul class="space-y-2.5">
                <% client.executiveHealthCheck.actionFixes.forEach(item => { %>
                  <li class="text-xs font-bold text-brand-dark leading-relaxed bg-white/70 p-2.5 rounded-xl border border-brand-dark/15 shadow-2xs">
                    <strong class="block text-brand-dark mb-0.5"><%= item.title %></strong>
                    <span class="text-brand-dark/85 font-semibold">Utjecaj: <%= item.impact %></span>
                  </li>
                <% }); %>
              </ul>
            </div>

          </div>
        </div>
        
        <!-- Section Breadcrumb & Status Bar -->
        <div class="flex justify-between items-center mb-6">
          <div class="flex items-center gap-2">
            <span class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Prikaz:</span>
            <span id="platform-title-badge" class="text-xs uppercase tracking-wider text-brand-dark font-black px-3 py-1 rounded bg-brand-dark/10 border border-brand-dark/15">360° Globalni Pregled</span>
          </div>
          <div class="glass-panel px-4 py-1.5 rounded-full flex items-center gap-2 text-xs">
            <span class="text-brand-dark/75 font-bold">Klijent status:</span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase <%= client.status === 'Active' ? 'bg-emerald-100 text-emerald-900 border border-emerald-300' : 'bg-brand-dark/10 text-brand-dark/60' %>">
              <%= client.status === 'Active' ? 'Aktivno' : 'Neaktivno' %>
            </span>
          </div>
        </div>

        <!-- PLATFORM 1: META STATISTICS SECTION -->
        <section id="panel-meta" class="hidden transition-all duration-300 opacity-0 scale-95">
          
          <!-- Hierarchical 12-column grid of Meta metric cards -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
            
            <!-- Card 1: Total Spend -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[160px] shadow-sm relative overflow-hidden group sm:col-span-6 xl:col-span-4">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Ukupna potrošnja</p>
                  <h3 class="text-3xl font-black text-brand-dark mt-1.5 tracking-tight"><%= client.metaStats.totalSpend %></h3>
                </div>
                <div class="w-9 h-9 rounded-xl bg-brand-dark/5 border border-brand-dark/15 flex items-center justify-center text-[#1877F2] text-base transition-all duration-300 group-hover:scale-110">
                  <i class="fa-brands fa-facebook-f"></i>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2.5 mt-1.5">
                <span>Facebook + Instagram zbirno</span>
                <span class="font-extrabold text-brand-dark">Meta Ads</span>
              </div>
            </div>
            
            <!-- Card 2: Cost Per Action (CPA) -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[160px] shadow-sm relative overflow-hidden group sm:col-span-6 xl:col-span-4">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Cijena po rezultatu (CPA)</p>
                  <div class="flex items-baseline gap-2 mt-1.5">
                    <h3 class="text-3xl font-black text-brand-dark tracking-tight"><%= client.metaStats.cpa %></h3>
                    <% if (client.metaStats.cpaTrend.direction === 'down') { %>
                      <span class="inline-flex items-center gap-1 text-xs font-black px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 border border-emerald-300">
                        <i class="fa-solid fa-arrow-down"></i> <%= client.metaStats.cpaTrend.value %>
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 text-xs font-black px-2 py-0.5 rounded bg-rose-100 text-rose-900 border border-rose-300">
                        <i class="fa-solid fa-arrow-up"></i> <%= client.metaStats.cpaTrend.value %>
                      </span>
                    <% } %>
                  </div>
                </div>
                <div class="w-9 h-9 rounded-xl bg-brand-dark/5 border border-brand-dark/15 flex items-center justify-center text-brand-dark text-base transition-all duration-300 group-hover:scale-110">
                  <i class="fa-solid fa-bullseye"></i>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2.5 mt-1.5">
                <span><%= client.metaStats.resultsType %></span>
                <span class="font-extrabold <%= client.metaStats.cpaTrend.direction === 'down' ? 'text-emerald-800' : 'text-rose-800' %>">
                  <%= client.metaStats.cpaTrend.direction === 'down' ? 'Pad cijene (odlično)' : 'Rast cijene' %>
                </span>
              </div>
            </div>
            
            <!-- Card 3: Results / ROAS -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[160px] shadow-sm relative overflow-hidden group sm:col-span-6 xl:col-span-2">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Rezultati / ROAS</p>
                  <h3 class="text-2xl font-black text-brand-dark mt-2 tracking-tight"><%= client.metaStats.resultsValue %></h3>
                </div>
                <div class="w-8 h-8 rounded-xl bg-brand-dark/5 border border-brand-dark/15 flex items-center justify-center text-brand-dark text-sm shrink-0">
                  <i class="fa-solid fa-chart-line"></i>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2.5 mt-1.5">
                <span class="truncate">Tip: <%= client.metaStats.resultsType.split(' ')[0] %></span>
              </div>
            </div>
            
            <!-- Card 4: Organic Reach -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[160px] shadow-sm relative overflow-hidden group sm:col-span-6 xl:col-span-2">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Organski doseg</p>
                  <h3 class="text-2xl font-black text-brand-dark mt-2 tracking-tight"><%= client.metaStats.organicReach %></h3>
                </div>
                <div class="w-8 h-8 rounded-xl bg-brand-dark/5 border border-brand-dark/15 flex items-center justify-center text-brand-dark text-sm shrink-0">
                  <i class="fa-solid fa-users"></i>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2.5 mt-1.5">
                <span>Reach objava</span>
              </div>
            </div>

          </div>
          
          <!-- Hierarchical Visualizations for Meta -->
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 mt-6">
            <!-- Chart 1: Trend učinkovitosti -->
            <div class="xl:col-span-8 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Trend učinkovitosti (Trošak vs. Konverzije)</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Ključni graf učinka</span>
              </div>
              <div id="meta-chart-efficiency" class="w-full" style="height: 350px;"></div>
            </div>
            
            <!-- Chart 2: Usporedba platformi -->
            <div class="xl:col-span-4 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Usporedba platformi</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Podjela troška</span>
              </div>
              <div id="meta-chart-platforms" class="w-full" style="height: 350px;"></div>
            </div>
          </div>
          
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 mt-6">
            <!-- Chart 4: Top 5 objava po angažmanu -->
            <div class="xl:col-span-5 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Top 5 objava po angažmanu</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Engagement ranking</span>
              </div>
              <div id="meta-chart-posts" class="w-full" style="height: 330px;"></div>
            </div>

            <!-- Chart 5: Trend dosega i interakcija -->
            <div class="xl:col-span-4 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Organski doseg kroz mjesec</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Mjesečni reach</span>
              </div>
              <div id="meta-chart-reach" class="w-full" style="height: 330px;"></div>
            </div>

            <!-- Chart 3: Analiza publike -->
            <div class="xl:col-span-3 glass-panel rounded-[1.75rem] p-6 shadow-sm">
              <div class="flex items-center justify-between mb-3">
                <h4 class="text-sm font-extrabold text-brand-dark uppercase tracking-wider">Analiza publike</h4>
                <span class="text-xs text-brand-dark/75 font-bold uppercase tracking-wider">Spol i dob</span>
              </div>
              <div id="meta-chart-audience" class="w-full" style="height: 330px;"></div>
            </div>
          </div>
        </section>

        <!-- PLATFORM 2: GOOGLE STATISTICS OVERHAULED & HIERARCHICAL SECTION -->
        <section id="panel-google" class="hidden transition-all duration-300 opacity-0 scale-95">
          
          <!-- KPI Cards Section (Trenutno stanje u brojkama) -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-4">
            
            <!-- KPI 1: Ukupni trošak i preostali budžet -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[160px] shadow-sm relative overflow-hidden group sm:col-span-6 xl:col-span-4">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">Trošak i preostali budžet</p>
                  <h3 class="text-2xl font-black text-brand-dark mt-2 tracking-tight">
                    <%= client.googleStats.totalSpend %> 
                    <span class="text-xs font-bold text-brand-dark/70">/ <%= client.googleStats.monthlyBudgetLimit %> limit</span>
                  </h3>
                </div>
                <span class="text-xs font-black px-2.5 py-1 rounded bg-brand-dark text-white"><%= client.googleStats.budgetPercent %>%</span>
              </div>
              <div class="mt-2.5">
                <div class="w-full bg-brand-dark/10 rounded-full h-2 overflow-hidden">
                  <div class="bg-brand-dark h-2 rounded-full" style="width: <%= client.googleStats.budgetPercent %>%"></div>
                </div>
              </div>
              <div class="flex justify-between items-center text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2.5 mt-1">
                <span>Preostali budžet: <strong><%= client.googleStats.preostaliBudzet %></strong></span>
                <span class="font-extrabold text-brand-dark">Google Ads</span>
              </div>
            </div>
            
            <!-- KPI 2: CPA / ROAS (Ostvareno vs. Cilj) -->
            <div class="glass-panel rounded-[1.75rem] p-5 flex flex-col justify-between h-[160px] shadow-sm relative overflow-hidden group sm:col-span-6 xl:col-span-4">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs uppercase tracking-wider text-brand-dark/75 font-bold">CPA (Ostvareno vs. Cilj)</p>
                  <h3 class="text-2xl font-black text-brand-dark mt-2 tracking-tight">
                    <%= client.googleStats.cpa %> 
                    <span class="text-xs font-bold text-brand-dark/70">/ <%= client.googleStats.cpaTarget %> cilj</span>
                  </h3>
                </div>
                <% if (client.googleStats.cpaTrend.direction === 'down') { %>
                  <span class="inline-flex items-center gap-1 text-xs font-black px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 border border-emerald-300">
                    <i class="fa-solid fa-arrow-down"></i> <%= client.googleStats.cpaTrend.value %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 text-xs font-black px-2 py-0.5 rounded bg-rose-100 text-rose-900 border border-rose-300">
                    <i class="fa-solid fa-arrow-up"></i> <%= client.googleStats.cpaTrend.value %>
                  </span>
                <% } %>
              </div>
              <div class="flex justify-between items-center text-xs text-brand-dark/75 font-bold border-t border-brand-dark/10 pt-2.5 mt-1.5">
                <span>Status:</span>
                <span class="font-extrabold <%= client.googleStats.cpaTrend.direction === 'down' ? 'text-emerald-800' : 'text-rose-800' %>">
                  <%= client.googleStats.cpaTrend.direction === 'down' ? 'Unutar cilja (Odlično)' : 'Iznad cilja' %>
                </span>
              </div>
            </div>
            
            <!-- KPI 3: Ukupan broj konverzije i CVR -->
