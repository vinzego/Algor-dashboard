                        <p className="text-xs text-gray-500 font-semibold">Link Clicks vs. Landing Page Views</p>
                      </div>
                      <span className="px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300 text-[10px] font-black">
                        24.1% Drop-off Rate
                      </span>
                    </div>
                    <EChartComponent option={metaAdsData.funnelOption} style={{ height: '280px', width: '100%' }} />
                    <div className="mt-3 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900 rounded-xl p-3 text-[11px] font-bold text-amber-900 dark:text-amber-200">
                      ⚠️ Gubitak veći od 20% ukazuje na sporo učitavanje odredišne stranice ili tehnički problem piksela.
                    </div>
                  </div>

                  {/* CHART 4: Video Creative Retention (Hook Rate vs Hold Rate) */}
                  <div className="lg:col-span-6 min-w-0 overflow-hidden z-card-white dark:bg-[#161618] z-card-white-hover rounded-[2rem] p-7 shadow-xs">
                    <div className="flex items-center justify-between mb-4 border-b border-gray-100 dark:border-gray-800 pb-3">
                      <div>
                        <h4 className="text-base font-black text-[#111113] dark:text-white uppercase tracking-wider">Video Retention</h4>
                        <p className="text-xs text-gray-500 font-semibold">Hook Rate (3s / Impr.) vs. Hold Rate (ThruPlays / 3s)</p>
                      </div>
                      <span className="z-badge-black text-[10px] px-3 py-1 shadow-xs">Video Funnel</span>
                    </div>
                    <EChartComponent option={metaAdsData.retentionOption} style={{ height: '340px', width: '100%' }} />
                  </div>
                </div>

                {/* CHARTS ROW 3: PLATFORM & PLACEMENT BREAKDOWN */}
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
                  <div className="lg:col-span-12 min-w-0 overflow-hidden z-card-white dark:bg-[#161618] z-card-white-hover rounded-[2rem] p-7 shadow-xs">
                    <div className="flex items-center justify-between mb-4 border-b border-gray-100 dark:border-gray-800 pb-3">
                      <div>
                        <h4 className="text-base font-black text-[#111113] dark:text-white uppercase tracking-wider">Platform & Placement Breakdown</h4>
                        <p className="text-xs text-gray-500 font-semibold">Raspodjela potrošnje po plasmanu (Instagram Feed, Reels, Facebook Feed, Stories)</p>
                      </div>
                    </div>
                    <EChartComponent option={metaAdsData.placementOption} style={{ height: '300px', width: '100%' }} />
                  </div>
                </div>

                {/* TABLE 6: Top Ad Creatives Leaderboard */}
                <div className="z-card-white dark:bg-[#161618] z-card-white-hover rounded-[2rem] p-7 shadow-xs overflow-hidden">
                  <div className="flex items-center justify-between mb-4 border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div>
                      <h4 className="text-base font-black text-[#111113] dark:text-white uppercase tracking-wider">Top Ad Creatives Leaderboard</h4>
                      <p className="text-xs text-gray-500 font-semibold">Detaljna analitika pojedinačnih oglasa po trošku, ROAS-u i retenciji</p>
                    </div>
                    <span className="text-xs font-bold text-gray-400">{sortedAds.length} Aktivna Oglasa</span>
                  </div>

                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-xs">
                      <thead>
                        <tr className="border-b border-gray-100 dark:border-gray-800 text-gray-400 font-extrabold uppercase tracking-wider">
                          <th className="py-3 px-2">Naziv Oglasa</th>
                          <th className="py-3 px-2">Plasman</th>
                          <th onClick={() => handleAdSort('spend')} className="py-3 px-2 cursor-pointer hover:text-zorange transition-colors">
                            Spend ($) {adSortKey === 'spend' && (adSortDir === 'asc' ? '↑' : '↓')}
                          </th>
                          <th onClick={() => handleAdSort('ctr')} className="py-3 px-2 cursor-pointer hover:text-zorange transition-colors">
                            CTR Link % {adSortKey === 'ctr' && (adSortDir === 'asc' ? '↑' : '↓')}
                          </th>
                          <th onClick={() => handleAdSort('cpa')} className="py-3 px-2 cursor-pointer hover:text-zorange transition-colors">
                            CPA ($) {adSortKey === 'cpa' && (adSortDir === 'asc' ? '↑' : '↓')}
                          </th>
                          <th onClick={() => handleAdSort('roas')} className="py-3 px-2 cursor-pointer hover:text-zorange transition-colors">
                            ROAS {adSortKey === 'roas' && (adSortDir === 'asc' ? '↑' : '↓')}
                          </th>
                          <th onClick={() => handleAdSort('hookRate')} className="py-3 px-2 cursor-pointer hover:text-zorange transition-colors">
                            Hook Rate % {adSortKey === 'hookRate' && (adSortDir === 'asc' ? '↑' : '↓')}
                          </th>
                          <th className="py-3 px-2">Status</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-100 dark:divide-gray-800 font-bold">
                        {sortedAds.map(ad => (
                          <tr key={ad.id} className="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <td className="py-3.5 px-2 text-[#111113] dark:text-white font-black">{ad.name}</td>
                            <td className="py-3.5 px-2">
                              <span className="px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-[10px] font-black">
                                {ad.placement}
                              </span>
                            </td>
                            <td className="py-3.5 px-2 text-[#111113] dark:text-white">${ad.spend.toFixed(2)}</td>
                            <td className="py-3.5 px-2 text-zorange font-black">{ad.ctr}%</td>
                            <td className="py-3.5 px-2 text-gray-700 dark:text-gray-300">${ad.cpa.toFixed(2)}</td>
                            <td className="py-3.5 px-2 text-emerald-600 dark:text-emerald-400 font-black">{ad.roas}x</td>
                            <td className="py-3.5 px-2 text-pink-600 dark:text-pink-400">{ad.hookRate}%</td>
                            <td className="py-3.5 px-2">
                              <span className={`px-2.5 py-1 rounded-full text-[10px] font-black uppercase flex items-center gap-1 w-max ${
                                ad.status === 'Active'
                                  ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300'
                                  : 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400'
                              }`}>
                                <span className={`w-1.5 h-1.5 rounded-full ${ad.status === 'Active' ? 'bg-emerald-500 animate-pulse' : 'bg-gray-400'}`}></span>
                                {ad.status}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

              </section>
            )}
          </main>

        </div>
      );
    }

    // Render React App
    const root = ReactDOM.createRoot(document.getElementById('react-root'));
    root.render(<DashboardApp />);
  </script>
</body>
</html>
