<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZELLIFY Marketing Dashboard</title>
  <!-- Tailwind Play CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zdark: '#111113',
            zgray: '#F4F5F7',
            zorange: '#FF5F00',
            zorangehover: '#E05300',
            zmuted: '#6B7280'
          },
          fontFamily: {
            sans: ['Urbanist', 'sans-serif']
          }
        }
      }
    }
  </script>
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#F4F5F7] min-h-screen relative pb-16 text-[#111113]">

  <!-- Container for centering and structure -->
  <div class="w-full max-w-[1680px] mx-auto px-6 sm:px-8 lg:px-10 py-6">
    
    <!-- ZELLIFY Header Pill Navbar -->
    <header class="mb-8">
      <nav class="bg-white rounded-full px-6 py-3.5 flex items-center justify-between shadow-sm border border-black/5">
        <!-- Logo -->
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-zorange flex items-center justify-center text-white font-black text-sm shadow-sm">
            <i class="fa-solid fa-bolt-lightning"></i>
          </div>
          <span class="text-xl font-black tracking-tight text-[#111113]">ZELLIFY<span class="text-zorange">.</span></span>
        </div>
        
        <!-- Navigation Links -->
        <div class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-wider">
          <a href="/" class="text-[#111113] border-b-2 border-zorange pb-0.5 font-black">Nadzorna ploča</a>
          <a href="#" class="text-gray-500 hover:text-[#111113] transition-colors">Klijenti</a>
          <a href="#" class="text-gray-500 hover:text-[#111113] transition-colors">Izvještaji</a>
          <a href="#" class="text-gray-500 hover:text-[#111113] transition-colors">Postavke</a>
        </div>
        
        <!-- User Info / Profile -->
        <div class="flex items-center gap-3">
          <div class="hidden sm:block text-right">
            <p class="text-xs font-black text-[#111113]">Vinko</p>
            <p class="text-[10px] font-bold text-gray-500 uppercase">Administrator</p>
          </div>
          <div class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center border border-black/10">
            <i class="fa-solid fa-user text-[#111113] text-sm"></i>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main Dashboard Section -->
    <main>
      <!-- Top Action Bar -->
      <div class="flex justify-between items-center mb-8">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-500">Pregled Klijenata</p>
          <h2 class="text-3xl font-black text-[#111113] tracking-tight mt-0.5">Marketing Sustavi Klijenata</h2>
        </div>

        <div class="flex gap-3 items-center">
          <div class="bg-white px-4 py-2 rounded-full flex items-center gap-2 shadow-xs border border-black/5">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-xs text-[#111113] font-black">Svi sustavi aktivni</span>
          </div>
          <button onclick="openModal()" class="z-badge-black px-5 py-2 text-xs flex items-center gap-2 hover:bg-gray-800 transition-colors shadow-xs">
            <i class="fa-solid fa-plus text-xs"></i> Dodaj klijenta
          </button>
        </div>
      </div>

      <!-- Clients Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% clients.forEach(client => { %>
          <!-- Client Card -->
          <a href="/client/<%= client.id %>" class="z-card-white z-card-white-hover rounded-[2rem] p-7 flex flex-col justify-between h-[430px] relative overflow-hidden group block shadow-sm border border-black/5">
            
            <!-- Card Header -->
            <div>
              <div class="flex justify-between items-start mb-4">
                <!-- Client Initials Icon -->
                <div class="w-12 h-12 rounded-2xl flex items-center justify-center font-black text-lg bg-[#111113] text-white shadow-sm transition-transform duration-300 group-hover:scale-110">
                  <%= client.logo %>
                </div>
                
                <!-- Package & Status Badges -->
                <div class="flex flex-col items-end gap-1.5">
                  <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-zorange text-white shadow-xs">
                    <%= client.package %>
                  </span>
                  <span class="z-badge-green px-2.5 py-0.5 text-[10px] uppercase">
                    <%= client.status === 'Active' ? 'Aktivno' : 'Neaktivno' %>
                  </span>
                </div>
              </div>
              
              <h2 class="text-2xl font-black text-[#111113] transition-colors duration-300"><%= client.name %></h2>
              
              <!-- Monthly Posts Tracker -->
              <div class="mt-4 bg-gray-50 rounded-2xl p-3.5 border border-gray-100">
                <div class="flex justify-between items-center text-xs text-gray-600 font-bold mb-1.5">
                  <span>Objave u tekućem mjesecu:</span>
                  <span class="text-[#111113] font-black"><%= client.publishedPosts %> / <%= client.maxPosts %></span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
                  <% const pct = Math.min((client.publishedPosts / client.maxPosts) * 100, 100); %>
                  <div class="bg-zorange h-2 rounded-full transition-all duration-500" style="width: <%= pct %>%;"></div>
                </div>
              </div>
            </div>

            <!-- Stats Middle Section -->
            <div class="grid grid-cols-2 gap-y-3.5 py-3.5 border-y border-gray-100 my-3.5">
              <div>
                <p class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Doseg (Reach)</p>
                <p class="text-xl font-black text-[#111113] mt-0.5"><%= client.stats.reach %></p>
              </div>
              <div>
                <p class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Prikazi</p>
                <p class="text-xl font-black text-[#111113] mt-0.5"><%= client.stats.impressions %></p>
              </div>
              <div>
                <p class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">CTR</p>
                <p class="text-xl font-black text-[#111113] mt-0.5"><%= client.stats.ctr %></p>
              </div>
              <div>
                <p class="text-[10px] uppercase tracking-wider text-gray-400 font-bold">Budžet</p>
                <p class="text-xl font-black text-zorange mt-0.5"><%= client.stats.spend %></p>
              </div>
            </div>

            <!-- Card Action Footer -->
            <div class="flex items-center justify-between">
              <!-- Icons of active marketing channels -->
              <div class="flex items-center gap-1.5">
                <span class="w-7 h-7 rounded bg-gray-100 border border-black/5 flex items-center justify-center text-xs text-blue-600 shadow-xs" title="Meta Ads"><i class="fa-brands fa-facebook-f"></i></span>
                <span class="w-7 h-7 rounded bg-gray-100 border border-black/5 flex items-center justify-center text-xs text-rose-500 shadow-xs" title="Google Ads (PMax)"><i class="fa-brands fa-google"></i></span>
                <span class="w-7 h-7 rounded bg-gray-100 border border-black/5 flex items-center justify-center text-xs text-black shadow-xs" title="TikTok Video Ads"><i class="fa-brands fa-tiktok"></i></span>
                <span class="w-7 h-7 rounded bg-gray-100 border border-black/5 flex items-center justify-center text-xs text-emerald-600 shadow-xs" title="Objave & Sadržaj"><i class="fa-solid fa-photo-film"></i></span>
              </div>
              
              <div class="flex items-center gap-1.5 group-hover:translate-x-1 transition-transform duration-300">
                <span class="text-xs font-black text-[#111113]">Detalji</span>
                <button class="w-8 h-8 rounded-full flex items-center justify-center bg-[#111113] text-white font-black text-xs transition-colors">
                  <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
              </div>
            </div>
            
          </a>
        <% }) %>
      </div>
    </main>

  </div>

  <!-- Add Client Modal Dialog Container -->
  <div id="add-client-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs opacity-0 pointer-events-none transition-all duration-300">
    <div class="bg-white w-full max-w-md p-8 rounded-[2rem] shadow-2xl scale-90 transition-all duration-300 relative border border-black/10 text-[#111113]">
      <!-- Close Button -->
      <button onclick="closeModal()" class="absolute right-5 top-5 w-8 h-8 rounded-full bg-gray-100 border border-black/5 flex items-center justify-center text-[#111113] hover:bg-black hover:text-white transition-all duration-300">
        <i class="fa-solid fa-xmark text-xs"></i>
      </button>
      
      <div class="flex items-center gap-2.5 mb-6">
        <div class="w-8 h-8 rounded-xl bg-zorange flex items-center justify-center text-white shadow-sm">
          <i class="fa-solid fa-user-plus text-xs"></i>
        </div>
        <h3 class="text-lg font-black text-[#111113] uppercase tracking-wider">Dodaj novog klijenta</h3>
      </div>
      
      <form action="/api/client/add" method="POST" class="space-y-4 text-xs font-bold text-[#111113]">
        <!-- Name -->
        <div class="flex flex-col gap-1">
          <label for="client-name">Naziv klijenta *</label>
          <input type="text" id="client-name" name="name" required placeholder="npr. Orion Group" class="w-full bg-gray-100 border border-black/10 rounded-xl px-4 py-2.5 text-[#111113] placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-zorange">
        </div>
        
        <!-- Logo Initials -->
        <div class="flex flex-col gap-1">
          <label for="client-logo">Inicijali logotipa (2 slova) *</label>
          <input type="text" id="client-logo" name="logo" required maxlength="2" placeholder="OG" class="w-full bg-gray-100 border border-black/10 rounded-xl px-4 py-2.5 text-[#111113] placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-zorange uppercase">
        </div>

        <!-- Package -->
        <div class="flex flex-col gap-1">
          <label for="client-package">Paket suradnje *</label>
          <select id="client-package" name="package" class="w-full bg-gray-100 border border-black/10 rounded-xl px-4 py-2.5 text-[#111113] focus:outline-none focus:ring-1 focus:ring-zorange">
            <option value="Start">Start (Osnovno)</option>
            <option value="Pro" selected>Pro (Napredno)</option>
            <option value="Ultra">Ultra (Potpuno)</option>
          </select>
        </div>

        <!-- Monthly Target Posts -->
        <div class="flex flex-col gap-1">
          <label for="client-maxPosts">Planirani mjesečni broj objava *</label>
          <input type="number" id="client-maxPosts" name="maxPosts" value="8" min="1" max="30" class="w-full bg-gray-100 border border-black/10 rounded-xl px-4 py-2.5 text-[#111113] focus:outline-none focus:ring-1 focus:ring-zorange">
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <button type="submit" class="w-full bg-[#111113] text-white py-3 rounded-full font-black text-xs uppercase tracking-wider hover:bg-zorange transition-colors shadow-md">
            Spremi novog klijenta
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal() {
      const modal = document.getElementById('add-client-modal');
      const dialog = modal.querySelector('div');
      modal.classList.remove('opacity-0', 'pointer-events-none');
      dialog.classList.remove('scale-90');
      dialog.classList.add('scale-100');
    }

    function closeModal() {
      const modal = document.getElementById('add-client-modal');
      const dialog = modal.querySelector('div');
      dialog.classList.remove('scale-100');
      dialog.classList.add('scale-90');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    document.getElementById('add-client-modal').addEventListener('click', (e) => {
      if (e.target.id === 'add-client-modal') {
        closeModal();
      }
    });
  </script>
</body>
</html>
